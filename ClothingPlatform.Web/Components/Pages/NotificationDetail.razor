@page "/notification/{NotificationId:int}"
@using ClothingPlatform.DB.AppDbModels
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

<div class="noti-detail-container">
    <div class="noti-detail-header">
        <button class="btn-back" @onclick="GoBack">
            <i class="bi bi-arrow-left-short"></i> Back to Shop
        </button>
    </div>

    @if (isLoading)
    {
        <div class="noti-detail-card loading-state">
            <div class="spinner"></div>
            <p>Retransmitting notification details...</p>
        </div>
    }
    else if (noti == null)
    {
        <div class="noti-detail-card error-state">
            <div class="noti-icon-wrapper error">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h3>Notification Not Found</h3>
            <p>The requested notification could not be located or access is restricted.</p>
        </div>
    }
    else
    {
        <div class="noti-detail-card">
            <!-- Notification Icon and Metadata -->
            <div class="noti-card-header">
                <div class="noti-icon-wrapper @(noti.Title.Contains("Confirmed", StringComparison.OrdinalIgnoreCase) ? "confirmed" : 
                                                 noti.Title.Contains("Cancel", StringComparison.OrdinalIgnoreCase) ? "cancelled" : "info")">
                    @if (noti.Title.Contains("Confirmed", StringComparison.OrdinalIgnoreCase))
                    {
                        <i class="bi bi-check-circle"></i>
                    }
                    else if (noti.Title.Contains("Cancel", StringComparison.OrdinalIgnoreCase))
                    {
                        <i class="bi bi-x-circle"></i>
                    }
                    else
                    {
                        <i class="bi bi-bell"></i>
                    }
                </div>
                <div class="noti-meta-info">
                    <h2 class="noti-title">@noti.Title</h2>
                    <span class="noti-date"><i class="bi bi-calendar3"></i> @formattedDate</span>
                </div>
            </div>

            <div class="divider"></div>

            <!-- Message Content -->
            <div class="noti-card-body">
                <div class="noti-message-bubble">
                    <p class="noti-message-text">@noti.Message</p>
                </div>
            </div>

            <!-- Action Area -->
            <div class="noti-card-footer">
                @if (noti.OrderId.HasValue)
                {
                    <div class="action-buttons-group">
                        @if (noti.Title.Contains("Confirmed", StringComparison.OrdinalIgnoreCase))
                        {
                            <button class="btn-primary-action" @onclick="ViewReceipt">
                                <i class="bi bi-receipt-cutoff"></i> View Official Receipt
                            </button>
                        }
                        else
                        {
                            <button class="btn-primary-action" @onclick="ViewPurchases">
                                <i class="bi bi-bag-heart"></i> View My Purchases
                            </button>
                        }
                    </div>
                }
                else
                {
                    <button class="btn-secondary-action" @onclick="GoBack">
                        Return to Shop
                    </button>
                }
            </div>
        </div>
    }
</div>

<style>
    .noti-detail-container {
        max-width: 650px;
        margin: 60px auto;
        padding: 0 24px;
        font-family: 'DM Sans', 'Outfit', system-ui, -apple-system, sans-serif;
    }

    .noti-detail-header {
        margin-bottom: 24px;
    }

    .btn-back {
        padding: 8px 16px;
        border-radius: 20px;
        border: 1px solid rgba(212, 178, 167, 0.4);
        background: rgba(255, 255, 255, 0.8);
        color: #7A5C50;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .btn-back:hover {
        background: #3C1F10;
        border-color: #3C1F10;
        color: #FFF;
        transform: translateX(-3px);
    }

    .noti-detail-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        border: 1px solid rgba(212, 178, 167, 0.25);
        box-shadow: 0 15px 35px rgba(122, 92, 80, 0.06), 0 5px 15px rgba(0, 0, 0, 0.02);
        padding: 40px;
        transition: all 0.3s ease;
    }

    .loading-state, .error-state {
        text-align: center;
        padding: 60px 40px;
    }

    .spinner {
        width: 36px;
        height: 36px;
        border: 3px solid rgba(212, 178, 167, 0.2);
        border-top: 3px solid #3C1F10;
        border-radius: 50%;
        animation: spin 1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        margin: 0 auto 20px;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .noti-card-header {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .noti-icon-wrapper {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        flex-shrink: 0;
        box-shadow: inset 0 -2px 4px rgba(0,0,0,0.02);
    }

    .noti-icon-wrapper.confirmed {
        background: rgba(46, 90, 68, 0.08);
        color: #2E5A44;
        border: 1px solid rgba(46, 90, 68, 0.15);
    }

    .noti-icon-wrapper.cancelled {
        background: rgba(192, 57, 43, 0.08);
        color: #C0392B;
        border: 1px solid rgba(192, 57, 43, 0.15);
    }

    .noti-icon-wrapper.info {
        background: rgba(218, 165, 32, 0.08);
        color: #DAA520;
        border: 1px solid rgba(218, 165, 32, 0.15);
    }

    .noti-icon-wrapper.error {
        background: rgba(220, 53, 69, 0.08);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.15);
        margin: 0 auto 20px;
    }

    .noti-meta-info {
        flex-grow: 1;
    }

    .noti-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: #3C1F10;
        margin: 0 0 6px 0;
        line-height: 1.25;
        letter-spacing: -0.2px;
    }

    .noti-date {
        font-size: 0.8rem;
        color: #9C8070;
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 500;
    }

    .divider {
        height: 1px;
        background: linear-gradient(90deg, rgba(212, 178, 167, 0) 0%, rgba(212, 178, 167, 0.3) 20%, rgba(212, 178, 167, 0.3) 80%, rgba(212, 178, 167, 0) 100%);
        margin: 28px 0;
    }

    .noti-card-body {
        margin-bottom: 30px;
    }

    .noti-message-bubble {
        background: #FAF8F6;
        border-radius: 14px;
        padding: 24px;
        border: 1px solid rgba(212, 178, 167, 0.12);
    }

    .noti-message-text {
        font-size: 0.95rem;
        line-height: 1.65;
        color: #554844;
        margin: 0;
        white-space: pre-line;
    }

    .noti-card-footer {
        display: flex;
        justify-content: flex-end;
    }

    .action-buttons-group {
        display: flex;
        gap: 16px;
        width: 100%;
    }

    .btn-primary-action {
        width: 100%;
        padding: 14px 28px;
        border-radius: 12px;
        border: none;
        background: #3C1F10;
        color: white;
        font-size: 0.92rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 4px 15px rgba(60, 31, 16, 0.15);
    }

    .btn-primary-action:hover {
        background: #502A16;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(60, 31, 16, 0.25);
    }

    .btn-secondary-action {
        padding: 12px 24px;
        border-radius: 12px;
        border: 1px solid rgba(212, 178, 167, 0.4);
        background: transparent;
        color: #7A5C50;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-secondary-action:hover {
        background: #FAF8F6;
        border-color: #3C1F10;
        color: #3C1F10;
    }
</style>

@code {
    [Parameter]
    public int NotificationId { get; set; }

    private CustomerNotification? noti;
    private bool isLoading = true;
    private string formattedDate = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            noti = await db.CustomerNotifications
                .FirstOrDefaultAsync(n => n.NotificationId == NotificationId);

            if (noti != null)
            {
                formattedDate = noti.CreatedAt.ToString("dd-MMM-yyyy hh:mm tt");
                
                // Mark as read if not already read
                if (!noti.IsRead)
                {
                    noti.IsRead = true;
                    db.CustomerNotifications.Update(noti);
                    await db.SaveChangesAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading notification: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/");
    }

    private void ViewReceipt()
    {
        if (noti?.OrderId != null)
        {
            Nav.NavigateTo($"/receipt/{noti.OrderId}");
        }
    }

    private void ViewPurchases()
    {
        Nav.NavigateTo("/"); // Redirect to home so they can view purchases history tab
    }
}
