      width:26px;
      height:1px;
      background:var(--gold-light);
      display:inline-block;
    }

    .promo-container .hero h1{
      font-family:'Cormorant Garamond',serif;
      font-weight:600;
      font-size:52px;
      line-height:1.12;
      margin:0 0 20px;
      max-width:640px;
      letter-spacing:0.2px;
      color: var(--cream-2);
    }
    .promo-container .hero h1 em{
      font-style:italic;
      font-weight:500;
      color:var(--gold-light);
    }

    .promo-container .hero p.lede{
      font-size:16px;
      line-height:1.65;
      color:rgba(246,238,228,0.82);
      max-width:480px;
      margin:0 0 36px;
      font-weight:400;
    }

    .promo-container .stats{
      display:flex;
      gap:0;
      flex-wrap:wrap;
    }
    .promo-container .stat{
      padding:0 32px;
      border-left:1px solid rgba(220,193,137,0.35);
      text-align: left;
    }
    .promo-container .stat:first-child{padding-left:0; border-left:none;}
    .promo-container .stat .num{
      font-family:'Cormorant Garamond',serif;
      font-size:30px;
      font-weight:600;
      color:var(--cream-2);
      display:block;
    }
    .promo-container .stat .label{
      font-size:12px;
      letter-spacing:1px;
      text-transform:uppercase;
      color:rgba(246,238,228,0.6);
      margin-top:4px;
    }

    /* ---------- FILTERS ---------- */
    .promo-container .filters{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      margin:40px 0 34px;
    }
    .promo-container .pill{
      font-family:'Jost',sans-serif;
      font-size:13.5px;
      letter-spacing:0.3px;
      padding:11px 22px;
      border-radius:999px;
      border:1px solid rgba(139,26,26,0.22);
      background:var(--cream-2);
      color:var(--ink);
      cursor:pointer;
      transition:all .2s ease;
      font-weight:500;
    }
    .promo-container .pill:hover{border-color:var(--burgundy); }
    .promo-container .pill:focus-visible{outline:2px solid var(--burgundy); outline-offset:2px;}
    .promo-container .pill.active{
      background:var(--burgundy);
      border-color:var(--burgundy);
      color:var(--cream-2);
    }

    /* ---------- DEAL OF THE MOMENT ---------- */
    .promo-container .deal-of-moment{
      background:var(--cream-2);
      border:1px solid rgba(139,26,26,0.10);
      border-radius:var(--radius);
      padding:30px 34px;
