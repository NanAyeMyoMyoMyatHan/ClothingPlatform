                    var mockRating = 4.5 + (prod.ProductId % 6) * 0.1;
                    var mockReviewCount = 12 + (prod.ProductId * 7) % 85;

                    <div class="promo-grid-card" style="cursor: pointer;" @onclick="() => OpenQuickViews(prod)">
                        <div class="promo-grid-img-wrap">
                            <FallbackImage Src="@primaryImg" Alt="@prod.Name" />
