                        </div>
                        <h4 style="font-size:0.92rem; font-weight:600; color:var(--charcoal); margin:0 0 4px;">@memberName</h4>
                        <p style="font-size:0.65rem; letter-spacing:0.15em; text-transform:uppercase; color:var(--rose); font-weight:600; margin:0 0 10px;">@role</p>
                        <p style="font-size:0.78rem; color:var(--charcoal-soft); line-height:1.7; margin:0;">@bio</p>
                    </div>
                }
            </div>
        </section>

        <!-- Visit Us CTA -->
        <section style="
            background: linear-gradient(135deg, #3C1F10 0%, #6B0F0F 100%);
            padding: 70px 40px;
            text-align: center;">
            <div style="max-width:600px; margin:0 auto;">
                <i class="bi bi-geo-alt-fill" style="font-size:2rem; color:#C9A96E; margin-bottom:20px; display:block;"></i>
                <h2 style="font-family:'DM Sans',sans-serif; font-size:1.8rem; font-weight:400; color:#F5F0E8; margin:0 0 16px; letter-spacing:0.02em;">Visit the Atelier</h2>
                <p style="font-size:0.88rem; color:rgba(245,240,232,0.75); line-height:1.85; margin:0 0 32px;">
                    We welcome you to our boutique in the heart of Golden Valley, Yangon. Come for a fitting, browse our latest collection, or simply enjoy a cup of tea with our team.
                </p>
                <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap; margin-bottom:32px;">
                    <div style="background:rgba(245,240,232,0.08); border:1px solid rgba(245,240,232,0.15); border-radius:10px; padding:16px 24px; text-align:center;">
                        <p style="font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:#C9A96E; margin:0 0 4px; font-weight:600;">Address</p>
                        <p style="font-size:0.85rem; color:#F5F0E8; margin:0;">Golden Valley, Bahan Township,<br/>Yangon, Myanmar</p>
                    </div>
                    <div style="background:rgba(245,240,232,0.08); border:1px solid rgba(245,240,232,0.15); border-radius:10px; padding:16px 24px; text-align:center;">
                        <p style="font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:#C9A96E; margin:0 0 4px; font-weight:600;">Hours</p>
                        <p style="font-size:0.85rem; color:#F5F0E8; margin:0;">Mon – Sat: 10am – 7pm<br/>Sunday: 11am – 5pm</p>
                    </div>
                    <div style="background:rgba(245,240,232,0.08); border:1px solid rgba(245,240,232,0.15); border-radius:10px; padding:16px 24px; text-align:center;">
                        <p style="font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:#C9A96E; margin:0 0 4px; font-weight:600;">Contact</p>
                        <p style="font-size:0.85rem; color:#F5F0E8; margin:0;">09 252 522 525<br/>hello@theboutique.mm</p>
                    </div>
                </div>
                <button @onclick='() => Navigate("home")' style="background:linear-gradient(135deg,#C9A96E,#B8924A); color:#3C1F10; border:none; border-radius:8px; padding:14px 36px; font-size:0.78rem; letter-spacing:0.2em; text-transform:uppercase; font-weight:700; cursor:pointer; transition:opacity 0.2s;">
                    Explore the Collection
                </button>
            </div>
        </section>
    }
</main>

