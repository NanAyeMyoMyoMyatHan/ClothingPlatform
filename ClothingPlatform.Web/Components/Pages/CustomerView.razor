                        ("https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=400&q=80", "Su Wai Phyo", "Head Seamstress", "With 15 years of haute couture experience, Su Wai ensures every seam is a statement of precision."),
                        ("https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?w=400&q=80", "Khin Myat Noe", "Fabric Curator", "Khin travels across Myanmar to source the finest silks, linens, and handwoven textiles."),
                        ("https://images.unsplash.com/photo-1548142813-c348350df52b?w=400&q=80", "Zin Mar Aung", "Client Relations", "Zin Mar is the warm voice behind every fitting appointment and the face of our atelier hospitality."),
                    };
                }
                @foreach (var (photo, memberName, role, bio) in team)
