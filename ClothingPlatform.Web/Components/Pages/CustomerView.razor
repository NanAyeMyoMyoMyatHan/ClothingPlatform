                        <!-- Badge -->
                        <span class="promo-grid-badge" style="background:#FFF3EE; color:#C9A96E; border:1px solid #EDD9D0;">Best Seller</span>

                        <!-- Delivery -->
                        <p class="promo-grid-delivery">
                            FREE delivery <strong>tomorrow</strong> in Yangon.<br/>
