                    </div>
                }
            }
        </div>

        <Pagination CurrentPage="@PageNoB"
                    TotalPages="@TotalPagesB"
                    CurrentPageChanged="@ChangeBPage" />
    }
    
    else if (activeTab == "shop")
    {
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; padding:0 2px;">
        <div>
            <span style="font-size:0.6rem; letter-spacing:0.25em; text-transform:uppercase; color:var(--charcoal-soft); font-weight:600;">This Week</span>
            <h2 style="font-family:'DM Sans',sans-serif; font-size:1.15rem; font-weight:500; color:var(--charcoal); margin:4px 0 0; letter-spacing:0.03em;">
                The <span style="color:var(--rose); font-style:italic;">Collection</span>
            </h2>
        </div>
        <span style="font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--charcoal-soft); opacity:0.7;">Here is the collection</span>
