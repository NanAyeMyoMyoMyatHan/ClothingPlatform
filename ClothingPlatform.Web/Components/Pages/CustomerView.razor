                @{
                    var milestones = new[]
                    {
                        ("2018", "The Beginning", "Chic Boutique opens its doors in Golden Valley as a made-to-order studio with a team of three.", true),
                        ("2020", "First Collection Launch", "Debuted our first ready-to-wear seasonal line — \"Monsoon Atelier\" — which sold out within two weeks.", false),
                        ("2022", "Online Platform", "Launched our digital atelier, bringing curated fashion to women across Myanmar with free Yangon delivery.", true),
                        ("2024", "Loyalty Boutique Program", "Introduced our signature loyalty rewards system, celebrating our most devoted clients.", false),
                        ("2026", "Today & Beyond", "Expanding our bespoke offerings and seasonal collaborations with local fabric artisans.", true),
                    };
                }

                @foreach (var (year, title, desc, isLeft) in milestones)
                {
                    <div style="display:grid; grid-template-columns:1fr 48px 1fr; gap:0; margin-bottom:32px; align-items:center;">
