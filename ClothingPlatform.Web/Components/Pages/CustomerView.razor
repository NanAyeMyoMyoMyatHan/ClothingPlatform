        transition: all 0.3s ease;
    }

    .noti-card-header {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .noti-icon-wrapper {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        flex-shrink: 0;
        box-shadow: inset 0 -2px 4px rgba(0,0,0,0.02);
    }

    .noti-icon-wrapper.confirmed {
        background: rgba(46, 90, 68, 0.08);
        color: #2E5A44;
        border: 1px solid rgba(46, 90, 68, 0.15);
    }

    .noti-icon-wrapper.cancelled {
        background: rgba(192, 57, 43, 0.08);
        color: #C0392B;
        border: 1px solid rgba(192, 57, 43, 0.15);
    }

    .noti-icon-wrapper.info {
        background: rgba(218, 165, 32, 0.08);
        color: #DAA520;
        border: 1px solid rgba(218, 165, 32, 0.15);
    }

    .noti-icon-wrapper.error {
        background: rgba(220, 53, 69, 0.08);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.15);
        margin: 0 auto 20px;
    }

    .noti-meta-info {
        flex-grow: 1;
    }

    .noti-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: #3C1F10;
        margin: 0 0 6px 0;
        line-height: 1.25;
        letter-spacing: -0.2px;
    }

    .noti-date {
        font-size: 0.8rem;
        color: #9C8070;
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 500;
    }

    .noti-divider {
        height: 1px;
        background: linear-gradient(90deg, rgba(212, 178, 167, 0) 0%, rgba(212, 178, 167, 0.3) 20%, rgba(212, 178, 167, 0.3) 80%, rgba(212, 178, 167, 0) 100%);
        margin: 28px 0;
    }

    .noti-card-body {
        margin-bottom: 30px;
    }

    .noti-message-bubble {
        background: #FAF8F6;
        border-radius: 14px;
        padding: 24px;
        border: 1px solid rgba(212, 178, 167, 0.12);
    }

    .noti-message-text {
        font-size: 0.95rem;
        line-height: 1.65;
