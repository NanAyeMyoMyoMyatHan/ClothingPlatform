@page "/"
@page "/customer"
@using ClothingPlatform.Web.Components.Partial
@using ClothingPlatform.Api.Models.Order
@inject IJSRuntime JSRuntime
@implements IDisposable

@inject AuthenticationStateProvider AuthenStateProvider

<PageTitle>Chic Boutique  Luxury Atelier</PageTitle>

<style>
    :root {
        --rose: var(--brand, #8B1A1A);
        --rose-light: var(--border, #EDD9D0);
        --rose-pale: var(--bg-warm, #F5ECD7);
        --charcoal: var(--text, #3C1F10);

        --charcoal-soft: var(--muted, #7A5C50);
        --bg: var(--bg-warm, #F5ECD7);
        --bg-start: var(--bg-warm, #F5ECD7);
        --bg-end: var(--bg-warm, #F5ECD7);
        --white: var(--surface, #FFFFFF);
        --shadow: rgba(139,26,26,0.10);
        --gold: var(--accent-gold, #C9A96E);
        --success: var(--success-text, #15803D);
        --red: var(--danger-text, #9F1D1D);
        --red-light: var(--danger-bg, #FEE2E2);
        --navy: var(--brand, #8B1A1A);
        --slate: var(--muted, #7A5C50);
        --slate-border: var(--border, #EDD9D0);
        --off-white: var(--surface-tint, #FFF3EE);
        --radius-lg: 10px;
        --shadow-lg: 0 8px 32px rgba(139,26,26,.14);
        --transition: 0.22s cubic-bezier(.4,0,.2,1);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'DM Sans', sans-serif;
        background: var(--bg);
        color: var(--charcoal);
        min-height: 100vh;
        overflow-x: hidden;
    }

    ::-webkit-scrollbar {
        width: 5px;
    }

    ::-webkit-scrollbar-track {
        background: var(--bg);
    }

    ::-webkit-scrollbar-thumb {
        background: var(--rose-light);
        border-radius: 99px;
    }

    /* Header */
    #site-header {
        position: sticky;
        top: 0;
        z-index: 700;
        background: rgba(253,248,246,0.96);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
    }

    .header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 40px;
    }

    .logo {
        font-family: 'DM Sans', sans-serif;
        font-size: 1.7rem;
        font-weight: 600;
        letter-spacing: 0.22em;
        color: var(--charcoal);
        text-decoration: none;
        cursor: pointer;
    }

        .logo span {
            color: var(--rose);
        }

    .logo-tagline {
        font-size: 0.62rem;
        letter-spacing: 0.3em;
        color: var(--rose);
        font-weight: 400;
        display: block;
        text-align: center;
        margin-top: -4px;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .btn-bag {
        position: relative;
        background: none;
        border: none;
        font-size: 1.25rem;
        color: var(--charcoal);
        cursor: pointer;
        padding: 6px 10px;
        transition: color 0.2s;
    }

        .btn-bag:hover {
            color: var(--rose);
        }

    .bag-badge {
        position: absolute;
        top: 0;
        right: 0;
        background: var(--rose);
        color: #F5F0E8;
        font-size: 0.6rem;
        font-weight: 700;
        width: 17px;
        height: 17px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .notification-btn {
        position: relative;
        background: none;
        border: none;
        color: var(--charcoal);
        font-size: 1.1rem;
        padding: 6px 8px;
        cursor: pointer;
    }

    .notification-badge {
        position: absolute;
        top: -1px;
        right: -1px;
        min-width: 16px;
        height: 16px;
        border-radius: 999px;
        background: #C0392B;
        color: #fff;
        font-size: 0.58rem;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 4px;
    }

    /* -- Notifications Drawer -- */
    .noti-backdrop {
        position: fixed;
        inset: 0;
        z-index: 800;
        background: rgba(0,0,0,0.4);
        backdrop-filter: blur(3px);
        display: none;
    }

    .noti-backdrop.open {
        display: block;
        animation: fadeIn 0.25s;
    }

    .noti-drawer {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        z-index: 850;
        width: min(420px, 100vw);
        background: var(--white);
        transform: translateX(100%);
        transition: transform 0.38s cubic-bezier(.77,0,.175,1);
        display: flex;
        flex-direction: column;
        box-shadow: -8px 0 48px rgba(139,26,26,0.12);
    }

    .noti-drawer.open {
        transform: translateX(0);
    }

    .noti-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 24px 28px;
        border-bottom: 1px solid var(--border);
    }

    .noti-title {
        font-family: 'DM Sans', sans-serif;
        font-size: 1.3rem;
        font-weight: 500;
        color: var(--charcoal);
        letter-spacing: 0.05em;
    }

    .noti-close {
        background: none;
        border: none;
        font-size: 1.1rem;
        color: var(--charcoal-soft);
        cursor: pointer;
    }

    .noti-close:hover {
        color: var(--rose);
    }

    .noti-body {
        flex: 1;
        overflow-y: auto;
        padding: 20px 28px;
    }

    .noti-empty {
        text-align: center;
        padding: 60px 20px;
    }

    .noti-empty i {
        font-size: 3rem;
        color: var(--rose-light);
    }

    .noti-empty p {
        margin-top: 15px;
        color: #7A5C50;
        font-size: 0.95rem;
    }

    /* Notification Items in Drawer */
    .noti-drawer-item {
        padding: 16px 20px;
        border-bottom: 1px solid #FAF0EE;
        cursor: pointer;
        transition: background-color 0.2s, transform 0.2s;
        border-radius: 8px;
        margin-bottom: 8px;
    }

    .noti-drawer-item:hover {
        background-color: #FFF3EE;
        transform: translateY(-1px);
    }

    .noti-drawer-item.unread {
        background-color: rgba(139, 26, 26, 0.04);
        border-left: 3px solid #8B1A1A;
    }

    .noti-drawer-title {
        font-weight: 600;
        font-size: 0.9rem;
        color: #3C1F10;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .noti-drawer-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #8B1A1A;
    }

    .noti-drawer-message {
        font-size: 0.82rem;
        color: #7A5C50;
        margin-top: 6px;
        line-height: 1.4;
    }

    .noti-drawer-time {
        font-size: 0.72rem;
        color: #C9A96E;
        margin-top: 8px;
        text-align: right;
    }

    .noti-drawer-footer {
        padding: 20px 28px;
        border-top: 1px solid var(--border);
        background: #FFF3EE;
        display: flex;
        justify-content: center;
    }

    .noti-drawer-mark-btn {
        background: #8B1A1A;
        border: none;
        color: #F5F0E8;
        padding: 10px 20px;
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: 8px;
        cursor: pointer;
        width: 100%;
        text-align: center;
        transition: background 0.15s;
    }

    .noti-drawer-mark-btn:hover {
        background: #6E1212;
    }

    /* Nav Tabs */
    .nav-tabs-bar {
        display: flex;
        align-items: center;
        gap: 0;
        padding: 0 40px;
        border-top: 1px solid var(--border);
        overflow-x: auto;
        scrollbar-width: none;
    }

        .nav-tabs-bar::-webkit-scrollbar {
            display: none;
        }

    .nav-tab {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.72rem;
        letter-spacing: 0.17em;
        font-weight: 500;
        color: var(--charcoal-soft);
        background: none;
        border: none;
        padding: 14px 22px;
        cursor: pointer;
        white-space: nowrap;
        border-bottom: 2px solid transparent;
        transition: color 0.2s, border-color 0.2s;
        text-transform: uppercase;
    }

        .nav-tab:hover {
            color: var(--rose);
        }

        .nav-tab.active {
            color: var(--rose);
            border-bottom-color: var(--rose);
        }

    /* Views */
    .view-wrapper {
        animation: fadeIn 0.35s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Hero */
    .hero {
        background: linear-gradient(135deg, #F5ECD7 0%, #FAF0EE 50%, #F5EAE8 100%);
        padding: 80px 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        /* Overlay effect */
        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient( ellipse 70% 60% at 60% 40%, rgba(139,26,26,0.12) 0%, transparent 70% );
            pointer-events: none;
            z-index: 0;
        }

    /* Eyebrow text */
    .hero-eyebrow {
        font-size: 0.68rem;
        letter-spacing: 0.35em;
        color: var(--rose);
        font-weight: 500;
        text-transform: uppercase;
        margin-bottom: 18px;
        position: relative;
        z-index: 1;
    }

    /* Title */
    /* Title */
    .hero-title {
        font-family: 'DM Sans', sans-serif;
        font-size: clamp(2.6rem, 6vw, 4.5rem);
        font-weight: 300;
        line-height: 1.1;
        color: var(--charcoal); /* ?????????? */
        text-shadow: none; /* shadow ??????????? ??? */
        margin-bottom: 20px;
        position: relative;
        z-index: 1;
    }

    /* Subtitle */
    .hero-sub {
        font-size: 0.88rem;
        color: #ffffff; /* ??? */
        text-shadow: 0 2px 6px rgba(255,255,255,0.6); /* ???? glow ???? */
        font-weight: 300;
        letter-spacing: 0.05em;
        max-width: 420px;
        line-height: 1.7;
        margin-bottom: 36px;
        position: relative;
        z-index: 1;
    }

    /* -- Logout confirmation modal -- */
    .confirm-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw; /* Force full viewport width */
        height: 100vh; /* Force full viewport height */
        background: rgba(15, 32, 80, .45);
        /* The magic centering trio */
        display: flex;
        align-items: center; /* Centers vertically */
        justify-content: center; /* Centers horizontally */

        z-index: 9999; /* Keeps it on top of sidebars/navbars */
    }

    .confirm-modal {
        background: var(--white);
        border-radius: var(--radius-lg);
        padding: 1.8rem 2rem;
        max-width: 360px;
        width: 90%;
        text-align: center;
        box-shadow: var(--shadow-lg);
    }

    .confirm-icon {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: var(--red-light);
        color: var(--red);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin: 0 auto .9rem;
    }

    .confirm-title {
        font-family: 'DM Sans', sans-serif;
        font-size: 1.25rem;
        color: var(--navy);
        margin-bottom: .4rem;
    }

    .confirm-text {
        font-size: .82rem;
        color: var(--slate);
        margin-bottom: 1.4rem;
        line-height: 1.5;
    }

    .confirm-actions {
        display: flex;
        gap: .7rem;
        justify-content: center;
    }

    .confirm-btn-cancel {
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        background: var(--off-white);
        color: var(--slate);
        border: 1px solid var(--slate-border);
        border-radius: 8px;
        padding: .55rem 1.3rem;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        transition: background var(--transition);
    }

        .confirm-btn-cancel:hover {
            background: #EDF1F6;
        }

    .confirm-btn-confirm {
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        background: var(--red);
        color: #000000;
        border: none;
        border-radius: 8px;
        padding: .55rem 1.3rem;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        transition: background var(--transition), transform var(--transition);
    }

        .confirm-btn-confirm:hover {
            background: #B91C1C;
            transform: translateY(-1px);
        }

    

    .btn-primary-rose {
        background: var(--rose);
        color: #F5ECD7;
        border: none;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.72rem;
        letter-spacing: 0.2em;
        font-weight: 500;
        text-transform: uppercase;
        padding: 14px 38px;
        cursor: pointer;
        transition: background 0.25s, transform 0.2s;
    }

        .btn-primary-rose:hover {
            background: #6B0F0F;
            transform: translateY(-1px);
        }

    /* Section Header */
    .section-head {
        padding: 56px 40px 28px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
    }

    .section-title {
        font-family: 'DM Sans', sans-serif;
        font-size: 2.1rem;
        font-weight: 400;
        color: var(--charcoal);
    }

        .section-title span {
            color: var(--rose);
            font-style: italic;
        }

    .section-count {
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        color: var(--rose);
        font-weight: 500;
    }

    /* Product Grid */
    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 28px;
        padding: 0 40px 60px;
    }

    .product-card {
        background: var(--white);
        border: 1px solid var(--border);
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.28s cubic-bezier(.25,.8,.25,1), box-shadow 0.28s;
        position: relative;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 48px var(--shadow);
        }

    .card-img-wrap {
        position: relative;
        overflow: hidden;
        aspect-ratio: 3/4;
        background: var(--rose-pale);
    }

        .card-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s cubic-bezier(.25,.8,.25,1);
        }

    .product-card:hover .card-img-wrap img {
        transform: scale(1.06);
    }

    .card-badge {
        position: absolute;
        top: 14px;
        left: 14px;
        background: var(--rose);
        color: #F5ECD7;
        font-size: 0.58rem;
        letter-spacing: 0.18em;
        font-weight: 600;
        padding: 4px 10px;
        text-transform: uppercase;
    }

    .card-quick {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(60,31,16,0.85);
        color: #F5ECD7;
        border: none;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.68rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        font-weight: 500;
        padding: 13px;
        transform: translateY(100%);
        transition: transform 0.3s cubic-bezier(.25,.8,.25,1);
        cursor: pointer;
        width: 100%;
    }

    .product-card:hover .card-quick {
        transform: translateY(0);
    }

    .card-body {
        padding: 18px 18px 22px;
    }

    .card-collection {
        font-size: 0.6rem;
        letter-spacing: 0.2em;
        color: var(--rose);
        font-weight: 500;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .card-name {
        font-family: 'DM Sans', sans-serif;
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--charcoal);
        margin-bottom: 8px;
        line-height: 1.3;
    }

    .card-price {
        font-size: 0.88rem;
        font-weight: 500;
        color: var(--charcoal-soft);
        letter-spacing: 0.03em;
    }

        .card-price .currency {
            font-size: 0.7rem;
            color: var(--rose);
            margin-left: 4px;
        }

    /* Product Modal */
    .modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(0,0,0,0.55);
        backdrop-filter: blur(4px);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .modal-overlay.open {
            display: flex;
            animation: fadeIn 0.25s ease;
        }

    .product-modal {
        background: var(--white);
        max-width: 800px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        position: relative;
    }

    @@media (max-width: 600px) {
        .product-modal {
            grid-template-columns: 1fr;
        }

        .modal-buy-actions {
            position: sticky;
            bottom: 0;
            top: auto;
            margin-left: -32px;
            margin-right: -32px;
            padding: 12px 32px 18px;
            border-top: 1px solid var(--border);
            box-shadow: 0 -12px 28px rgba(139,26,26,0.08);
        }
    }

    .modal-img-col {
        position: relative;
        aspect-ratio: 3/4;
        background: var(--rose-pale);
        overflow: hidden;
        min-height: 380px;
    }

        .modal-img-col img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .modal-info-col {
        padding: 36px 32px;
        overflow-y: auto;
    }

    .modal-collection {
        font-size: 0.62rem;
        letter-spacing: 0.25em;
        color: var(--rose);
        font-weight: 500;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .modal-name {
        font-family: 'DM Sans', sans-serif;
        font-size: 1.7rem;
        font-weight: 400;
        color: var(--charcoal);
        line-height: 1.2;
        margin-bottom: 10px;
    }

    .modal-price {
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--charcoal);
        margin-bottom: 18px;
    }

        .modal-price .currency {
            color: var(--rose);
            font-size: 0.8rem;
            margin-left: 5px;
        }

    .modal-desc {
        font-size: 0.84rem;
        color: var(--charcoal-soft);
        line-height: 1.75;
        font-weight: 300;
        margin-bottom: 26px;
        padding-bottom: 22px;
        border-bottom: 1px solid var(--border);
    }

    .option-label {
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--charcoal);
        margin-bottom: 10px;
        display: block;
    }

    .size-btns, .color-btns {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 22px;
    }

    .size-btn {
        border: 1px solid var(--border);
        background: var(--white);
        font-family: 'DM Sans', sans-serif;
        font-size: 0.72rem;
        font-weight: 500;
        padding: 7px 14px;
        cursor: pointer;
        letter-spacing: 0.08em;
        transition: all 0.2s;
        color: var(--charcoal);
    }

        .size-btn:hover, .size-btn.selected {
            border-color: var(--rose);
            background: var(--rose);
            color: #F5ECD7;
        }

    .color-btn {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 2px solid var(--border);
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        position: relative;
    }

        .color-btn:hover {
            transform: scale(1.15);
        }

        .color-btn.selected {
            box-shadow: 0 0 0 3px var(--white), 0 0 0 5px var(--rose);
        }

    .modal-error {
        font-size: 0.75rem;
        color: #c0392b;
        margin-bottom: 10px;
    }

    .btn-add-bag {
        width: 100%;
        background: var(--charcoal);
        color: #F5ECD7;
        border: none;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.72rem;
        letter-spacing: 0.22em;
        font-weight: 500;
        text-transform: uppercase;
        padding: 16px;
        cursor: pointer;
        transition: background 0.25s, transform 0.2s;
    }

    .modal-buy-actions {
        position: sticky;
        top: 18px;
        display: grid;
        gap: 12px;
        align-self: start;
        background: var(--white);
        padding-top: 6px;
    }

    .modal-qty-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border: 1px solid var(--border);
        padding: 10px 12px;
    }

        .btn-add-bag:hover {
            background: var(--rose);
            transform: translateY(-1px);
        }

    .modal-close {
        position: absolute;
        top: 14px;
        right: 14px;
        z-index: 10;
        background: #F5ECD7;
        border: 1px solid var(--border);
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        cursor: pointer;
        color: var(--charcoal);
        transition: background 0.2s, color 0.2s;
    }

        .modal-close:hover {
            background: var(--rose);
            color: #F5ECD7;
            border-color: var(--rose);
        }

    /* Cart Drawer */
    .cart-backdrop {
        position: fixed;
        inset: 0;
        z-index: 800;
        background: rgba(0,0,0,0.4);
        backdrop-filter: blur(3px);
        display: none;
    }

        .cart-backdrop.open {
            display: block;
            animation: fadeIn 0.25s;
        }

    .cart-drawer {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        z-index: 850;
        width: min(420px, 100vw);
        background: var(--white);
