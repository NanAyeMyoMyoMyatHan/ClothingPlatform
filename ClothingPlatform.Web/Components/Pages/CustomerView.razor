<!-- Exchange Picker Hover Overlay Modal -->
@if (showExchangePicker)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 99999;" @onclick="() => showExchangePicker = false">
        <div class="confirm-modal" style="width: 90%; max-width: 650px; max-height: 80vh; padding: 30px; display: flex; flex-direction: column; overflow: hidden; background: var(--white); border-radius: 16px; box-shadow: var(--shadow-xl);" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
                <h3 style="font-family: 'DM Sans', sans-serif; font-size: 1.2rem; font-weight: 600; color: var(--charcoal); margin: 0;">Select Replacement Creation</h3>
                <button type="button" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--charcoal-soft); line-height: 1;" @onclick="() => showExchangePicker = false">&times;</button>
            </div>

            <div style="flex: 1; overflow-y: auto; padding-right: 8px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    @foreach (var prod in allProducts)
                    {
                        var imgObj = prod.ProductImages?.FirstOrDefault(i => i.IsPrimary == true);
                        var prodImg = NormalizeImageUrl(imgObj?.ImageUrl);
                        <div class="exchange-prod-card" style="border: 1px solid var(--border); border-radius: 8px; padding: 12px; transition: all 0.3s ease; position: relative; background: var(--white);">
                            <div style="display: flex; gap: 12px;">
                                <FallbackImage Src="@prodImg" Alt="@prod.Name" style="width: 55px; height: 75px; object-fit: cover; border-radius: 4px;" />
                                <div style="flex: 1; text-align: left;">
                                    <h4 style="font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 600; color: var(--charcoal); margin-bottom: 4px; margin-top: 0; line-height: 1.2;">@prod.Name</h4>
                                    <p style="font-size: 0.75rem; color: var(--charcoal-soft); margin-bottom: 8px; margin-top: 0;">@prod.Category?.Name</p>
                                    
                                    <label style="font-size: 0.68rem; color: var(--charcoal-soft); display: block; margin-bottom: 2px; font-weight: 600;">Select Variant:</label>
                                    <select class="form-control-custom" style="padding: 4px 8px; font-size: 0.72rem; border-radius: 4px; height: auto;" 
                                            @onchange="(e) => OnSelectExchangeVariant(prod, e)">
                                        <option value="">-- Choose Variant --</option>
                                        @foreach (var variant in prod.ProductVariants)
                                        {
                                            <option value="@variant.VariantId">
                                                Size: @variant.Size, Color: @variant.Color (@(variant.SalePrice?.ToString("N0") ?? "0") MMK)
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<ConfirmModal @ref="confirmModal" />



