            </div>

            <div class="confirm-actions" style="display: flex; gap: 12px;">
                <button class="btn btn-cancel" style="background: #f4f4f5; color: #3f3f46; font-family: 'Outfit', sans-serif; flex: 1; padding: 10px 16px; border-radius: 8px; font-size: 14px; font-weight: 600; border: none; cursor: pointer;" @onclick="CloseCancelModal">Close</button>
                <button class="btn btn-confirm" style="background: #dc2626; color: #fff; font-family: 'Outfit', sans-serif; flex: 1; padding: 10px 16px; border-radius: 8px; font-size: 14px; font-weight: 600; border: none; cursor: pointer;" @onclick="SubmitCancelOrder">Confirm Cancellation</button>
            </div>
        </div>
    </div>
}

