      text-align: left;
    }
    .promo-container .dom-left{display:flex; align-items:center; gap:22px;}
    .promo-container .seal{
      width:64px;
      height:64px;
      border-radius:50%;
      flex-shrink:0;
      background:radial-gradient(circle at 32% 28%, #E4C67F, var(--gold) 55%, #93701F 100%);
      display:flex;
      align-items:center;
      justify-content:center;
      font-family:'Cormorant Garamond',serif;
      font-weight:600;
      font-size:20px;
      color:var(--burgundy-2);
      box-shadow:inset 0 0 0 3px rgba(255,255,255,0.35), 0 2px 6px rgba(0,0,0,0.18);
    }
    .promo-container .dom-tag{
      font-size:11px;
      letter-spacing:2px;
      text-transform:uppercase;
      color:var(--burgundy);
      font-weight:600;
      margin-bottom:6px;
    }
    .promo-container .dom-title{
      font-family:'Cormorant Garamond',serif;
      font-size:26px;
      font-weight:600;
      margin:0 0 6px;
      color:var(--ink);
    }
    .promo-container .dom-sub{
      font-size:13.5px;
      color:var(--taupe);
    }
    .promo-container .dom-right{
      display:flex;
      align-items:center;
      gap:12px;
    }
    .promo-container .code-box{
      font-family:'Jost',sans-serif;
      font-weight:600;
      letter-spacing:1.5px;
      padding:12px 20px;
      border:1.5px dashed var(--gold);
      border-radius:10px;
      color:var(--burgundy);
      background:var(--sand);
      font-size:14px;
    }
    .promo-container .copy-btn{
      font-family:'Jost',sans-serif;
      font-weight:500;
      font-size:13.5px;
      padding:13px 22px;
      border-radius:10px;
      border:none;
      background:var(--ink);
      color:var(--cream-2);
      cursor:pointer;
      transition:background .2s ease, transform .15s ease;
    }
    .promo-container .copy-btn:hover{background:var(--burgundy);}
    .promo-container .copy-btn:focus-visible{outline:2px solid var(--gold); outline-offset:2px;}
    .promo-container .copy-btn:active{transform:scale(0.97);}

    /* ---------- DEAL GRID ---------- */
    .promo-container .grid{
      display:grid;
      grid-template-columns:repeat(4, 1fr);
      gap:20px;
    }
    .promo-container .card{
      position:relative;
      border-radius:var(--radius);
      padding:22px;
      min-height:190px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      overflow:hidden;
      transition: transform 0.28s, box-shadow 0.28s;
      cursor: pointer;
      text-align: left;
    }
    .promo-container .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 20px rgba(42,33,28,0.15);
    }
    .promo-container .card.c1{background:var(--blush);}
    .promo-container .card.c2{background:var(--sage);}
    .promo-container .card.c3{background:var(--sand);}
    .promo-container .card.c4{background:var(--ivory);}

    .promo-container .card-top{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
    }
    .promo-container .badge{
      font-size:12px;
      font-weight:600;
      letter-spacing:0.4px;
      padding:6px 12px;
      border-radius:999px;
      background:var(--ink);
      color:var(--cream-2);
    }
    .promo-container .badge.end{
      background:rgba(255,255,255,0.65);
      color:var(--ink);
      font-weight:500;
    }
    .promo-container .card-icon{
      align-self:flex-end;
      width:46px;
      height:46px;
      color:var(--burgundy);
      opacity:0.85;
    }
    .promo-container .card-icon svg{width:100%; height:100%;}
    .promo-container .card-title{
      font-family:'Cormorant Garamond',serif;
      font-size:19px;
      font-weight:600;
      color:var(--ink);
      margin-top:14px;
    }

    @@media (max-width:980px){
      .promo-container .grid{grid-template-columns:repeat(2,1fr);}
      .promo-container .hero h1{font-size:40px;}
    }
    @@media (max-width:640px){
      .promo-container .grid{grid-template-columns:1fr;}
      .promo-container .hero{padding:40px 24px;}
      .promo-container .hero h1{font-size:32px;}
      .promo-container .stat{padding:0 18px;}
      .promo-container .dom-right{width:100%; justify-content:space-between;}
      .promo-container .deal-of-moment{padding:24px 20px;}
    }
</style>


<!-- --------------- HEADER --------------- -->
<header id="site-header">
    <div class="header-top">
        <a class="logo" @onclick='() => Navigate("home")'>
            CHIC <span>BOUTIQUE</span>
            <span class="logo-tagline">Atelier Coterie</span>
        </a>

        <div class="header-actions">
            <div class="d-none d-md-flex align-items-center border px-3 py-1 bg-white" style="border-radius: 20px;">
                <!-- Replace @onkeyup with the debounced handler -->
                <input type="text"
                       value="@searchQuery"
                       @oninput="OnSearchInput"
                       placeholder="Search creations..."
                       class="border-0 small"
                       style="outline:none; width:150px; font-size:0.8rem;" />
                <i class="bi bi-search text-muted" @onclick='() => Navigate("shop")' style="cursor:pointer;"></i>
            </div>

            <button class="btn-bag" @onclick="ToggleCart">
                <i class="bi bi-bag"></i>
                @if (CartCount > 0)
                {
                    <span class="bag-badge">@CartCount</span>
                }
            </button>

            @if (currentUser != null)
            {
                <button class="notification-btn" title="Notifications" @onclick="ToggleNotificationsDropdown">
                    <i class="bi bi-bell"></i>
                    @if (notifications.Any(n => !n.IsRead))
                    {
                        <span class="notification-badge">@notifications.Count(n => !n.IsRead)</span>
                    }
                </button>
            }

            @if (currentUser != null)
            {
                <span class="text-muted small d-none d-sm-inline">Mingalarpar, <strong>@currentUser.FirstName</strong></span>
            }
            else
            {
                <span class="text-muted small d-none d-sm-inline">Mingalarpar</span>
            }
        </div>
    </div>

    <nav class="nav-tabs-bar" style="overflow-x: auto; display: flex; white-space: nowrap; -webkit-overflow-scrolling: touch;">
        <button class="nav-tab @(activeTab == "home" ? "active" : "")" @onclick='() => Navigate("home")'>Home</button>
        <button class="nav-tab @(activeTab == "best" ? "active" : "")" @onclick='() => Navigate("best")'>Best Seller</button>
        <button class="nav-tab @(activeTab == "shop" ? "active" : "")" @onclick='() => Navigate("shop")'>The Collection</button>
        <button class="nav-tab @(activeTab == "promotions" ? "active" : "")" @onclick='() => { selectedPromotionDetail = null; Navigate("promotions"); }'>Promotions</button>
        <button class="nav-tab @(activeTab == "about" ? "active" : "")" @onclick='() => Navigate("about")'>About Us</button>
        <button class="nav-tab @(activeTab == "history" ? "active" : "")" @onclick='() => Navigate("history")'>My Purchases</button>
        <button class="nav-tab @(activeTab == "return" ? "active" : "")" @onclick='() => NavigateToReturnTab()'>Return / Exchange</button>
        <button class="nav-tab @(activeTab == "profile" ? "active" : "")" @onclick='() => Navigate("profile")'>My Profile</button>
