                    <span style="font-size: 12px; color: #6B7280;">@selectedNotification.CreatedAt.ToString("MMMM dd, yyyy h:mm tt")</span>
                </div>
                
                <div style="border-top: 1px solid #F3F4F6; border-bottom: 1px solid #F3F4F6; padding: 20px 0; margin-bottom: 24px; flex-grow: 1;">
