                                <p style="font-size:0.82rem; color:var(--charcoal-soft); line-height:1.7; margin:0;">@desc</p>
                            </div>
                            <div style="display:flex; justify-content:center;">
                                <div style="width:14px; height:14px; border-radius:50%; background:var(--rose); border:3px solid var(--rose-light); flex-shrink:0;"></div>
                            </div>
                            <div></div>
                        }
                        else
                        {
                            <div></div>
                            <div style="display:flex; justify-content:center;">
                                <div style="width:14px; height:14px; border-radius:50%; background:var(--rose); border:3px solid var(--rose-light); flex-shrink:0;"></div>
                            </div>
