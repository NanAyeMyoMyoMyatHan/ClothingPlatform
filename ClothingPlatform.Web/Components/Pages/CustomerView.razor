            <p class="confirm-message" style="font-size: 0.85rem; color: #71717a; margin-bottom: 20px; line-height: 1.4;">Please tell us why you want to cancel this order (optional).</p>
            
            <div style="margin-bottom: 24px; text-align: left;">
                <textarea style="width: 100%; min-height: 90px; padding: 12px; border-radius: 8px; border: 1px solid var(--border); font-family: 'Outfit', sans-serif; font-size: 0.85rem; resize: vertical; box-sizing: border-box;" 
                          placeholder="Type your reason here (optional)..." 
                          @bind="cancelReason" 
                          @bind:event="oninput">
