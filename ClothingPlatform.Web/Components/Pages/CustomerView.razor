<!-- --------------- NOTIFICATION DRAWER --------------- -->
<div class="noti-backdrop @(showNotificationsDropdown ? "open" : "")" @onclick="ToggleNotificationsDropdown"></div>
<div class="noti-drawer @(showNotificationsDropdown ? "open" : "")" style="background: white; color: #111827; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <div class="noti-header" style="display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; border-bottom: 1px solid #f3f4f6;">
        <span class="noti-title" style="font-size: 16px; font-weight: 600;">Notifications</span>
        <div style="display: flex; align-items: center; gap: 12px;">
            <button style="background: none; border: none; font-size: 16px; color: #4b5563; cursor: pointer; padding: 4px; display: flex; align-items: center;" title="Notification Settings">
                <i class="bi bi-gear"></i>
            </button>
            <button class="noti-close" @onclick="ToggleNotificationsDropdown" style="background: none; border: none; font-size: 16px; color: #4b5563; cursor: pointer; padding: 4px; display: flex; align-items: center;"><i class="bi bi-x-lg"></i></button>
        </div>
    </div>
    <div class="noti-body" style="padding: 0; overflow-y: auto; max-height: calc(100vh - 120px);">
        @if (!notifications.Any())
        {
            <div class="noti-empty" style="text-align: center; padding: 40px 20px;">
                <i class="bi bi-bell-slash" style="font-size:3rem; color:var(--rose-light);"></i>
                <p class="mt-3" style="color: #6b7280;">No notifications yet.</p>
            </div>
        }
        else
        {
            var unreadNotis = notifications.Where(n => !n.IsRead).ToList();
            var readNotis = notifications.Where(n => n.IsRead).ToList();

            @if (unreadNotis.Any())
            {
                <div style="font-size: 12px; font-weight: 700; padding: 12px 16px 6px 16px; color: #111827; background: #FAFAFA; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid #f3f4f6;">Important</div>
                @foreach (var noti in unreadNotis)
                {
                    var currentNoti = noti;
                    <div style="display: flex; align-items: flex-start; padding: 14px 16px; border-bottom: 1px solid #f3f4f6; cursor: pointer; transition: background 0.15s; position: relative; background: #F9FAFB;" 
                         class="noti-item-hover"
                         @onclick="() => HandleNotificationClick(currentNoti)">
                        
                        <!-- Unread blue dot -->
                        <div style="width: 8px; height: 8px; background: #0088cc; border-radius: 50%; position: absolute; left: 6px; top: 50%; transform: translateY(-50%);"></div>

                        <!-- Avatar icon -->
                        <div style="width: 40px; height: 40px; border-radius: 50%; background: #FDF4F2; display: flex; align-items: center; justify-content: center; color: var(--rose); margin-left: 6px; margin-right: 12px; flex-shrink: 0; font-size: 16px;">
                            @if (currentNoti.Title.Contains("Order", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-bag-check"></i>
                            }
                            else if (currentNoti.Title.Contains("Promo", StringComparison.OrdinalIgnoreCase) || currentNoti.Title.Contains("Discount", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-tag"></i>
                            }
                            else
                            {
                                <i class="bi bi-bell"></i>
                            }
                        </div>

                        <!-- Content -->
                        <div style="flex-grow: 1; min-width: 0; padding-right: 8px;">
                            <div style="font-size: 13px; line-height: 1.4; color: #111827; margin-bottom: 4px;">
                                <span style="font-weight: 600;">@currentNoti.Title</span>: @currentNoti.Message
                            </div>
                            <div style="font-size: 11px; color: #6b7280;">@GetTimeAgo(currentNoti.CreatedAt)</div>
                        </div>

                        <!-- Right Image Thumbnail -->
                        <div style="width: 40px; height: 40px; border-radius: 6px; background: #fff; border: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; margin-right: 8px;">
                            @if (currentNoti.OrderId.HasValue)
                            {
                                <i class="bi bi-receipt" style="font-size: 18px; color: #9ca3af;"></i>
                            }
                            else
                            {
                                <i class="bi bi-bell-fill" style="font-size: 18px; color: #9ca3af;"></i>
                            }
                        </div>

                        <div style="font-size: 16px; color: #9ca3af; padding-top: 2px; align-self: flex-start;" 
                             @onclick="async () => { await MarkAsRead(currentNoti); noti.IsRead = true; }"
                             @onclick:stopPropagation="true"
                             title="Mark as read">
                            <i class="bi bi-check-circle-fill" style="font-size: 15px; color: #10b981;"></i>
                        </div>
                    </div>
                }
            }

            @if (readNotis.Any())
            {
                <div style="font-size: 12px; font-weight: 700; padding: 12px 16px 6px 16px; color: #4b5563; background: #FAFAFA; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid #f3f4f6; border-top: 1px solid #f3f4f6;">More notifications</div>
                @foreach (var noti in readNotis)
                {
                    var currentNoti = noti;
                    <div style="display: flex; align-items: flex-start; padding: 14px 16px; border-bottom: 1px solid #f3f4f6; cursor: pointer; transition: background 0.15s; position: relative;" 
                         class="noti-item-hover"
                         @onclick="() => HandleNotificationClick(currentNoti)">
                        
                        <!-- Avatar icon -->
                        <div style="width: 40px; height: 40px; border-radius: 50%; background: #F3F4F6; display: flex; align-items: center; justify-content: center; color: #6b7280; margin-left: 6px; margin-right: 12px; flex-shrink: 0; font-size: 16px;">
                            @if (currentNoti.Title.Contains("Order", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-bag-check"></i>
                            }
                            else if (currentNoti.Title.Contains("Promo", StringComparison.OrdinalIgnoreCase) || currentNoti.Title.Contains("Discount", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-tag"></i>
                            }
                            else
                            {
                                <i class="bi bi-bell"></i>
                            }
                        </div>

                        <!-- Content -->
                        <div style="flex-grow: 1; min-width: 0; padding-right: 8px;">
                            <div style="font-size: 13px; line-height: 1.4; color: #374151; margin-bottom: 4px;">
                                <span style="font-weight: 500;">@currentNoti.Title</span>: @currentNoti.Message
                            </div>
                            <div style="font-size: 11px; color: #9ca3af;">@GetTimeAgo(currentNoti.CreatedAt)</div>
                        </div>

                        <!-- Right Image Thumbnail -->
                        <div style="width: 40px; height: 40px; border-radius: 6px; background: #fff; border: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; margin-right: 8px;">
                            @if (currentNoti.OrderId.HasValue)
                            {
                                <i class="bi bi-receipt" style="font-size: 18px; color: #9ca3af;"></i>
                            }
                            else
                            {
                                <i class="bi bi-bell-fill" style="font-size: 18px; color: #9ca3af;"></i>
                            }
                        </div>

                        <!-- Options dot -->
                        <div style="font-size: 14px; color: #9ca3af; padding-top: 2px; align-self: flex-start;">
                            <i class="bi bi-three-dots-vertical"></i>
                        </div>
                    </div>
                }
            }
        }
    </div>
    @if (notifications.Any(n => !n.IsRead))
    {
        <div class="noti-drawer-footer" style="padding: 12px 16px; border-top: 1px solid #f3f4f6; display: flex; justify-content: flex-end; background: #fff;">
            <button class="noti-drawer-mark-btn" @onclick="MarkAllNotificationsAsRead" style="background: none; border: none; color: var(--rose); font-weight: 600; font-size: 13px; cursor: pointer;">Mark all read</button>
        </div>
    }
</div>

