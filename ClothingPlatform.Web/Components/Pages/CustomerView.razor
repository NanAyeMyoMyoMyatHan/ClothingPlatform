                                <span style="font-size:0.65rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--rose); font-weight:600;">@year</span>
                                <h4 style="font-size:0.95rem; font-weight:600; color:var(--charcoal); margin:6px 0 4px;">@title</h4>
                                <p style="font-size:0.82rem; color:var(--charcoal-soft); line-height:1.7; margin:0;">@desc</p>
