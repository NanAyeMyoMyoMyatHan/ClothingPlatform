    /* Notification Detail Styles */
    .noti-detail-container {
        max-width: 650px;
        margin: 60px auto;
        padding: 0 24px;
        font-family: 'DM Sans', 'Outfit', system-ui, -apple-system, sans-serif;
    }

    .noti-detail-header {
        margin-bottom: 24px;
    }

    .btn-back {
        padding: 8px 16px;
        border-radius: 20px;
        border: 1px solid rgba(212, 178, 167, 0.4);
        background: rgba(255, 255, 255, 0.8);
        color: #7A5C50;
        font-size: 0.85rem;
        font-weight: 500;
