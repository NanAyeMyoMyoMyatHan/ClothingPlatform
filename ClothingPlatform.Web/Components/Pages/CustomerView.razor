    else if (activeTab == "checkout")
    {
    <div class="checkout-view">
        <div class="checkout-grid">
            <!-- Form Info -->
            <div>
                <h3 class="checkout-section-title">Delivery Details</h3>

                <div class="form-group">
                    <label class="form-label-custom">Recipient Full Name</label>
                    <input type="text" class="form-control-custom" @bind="coName" placeholder="Emily Watson" />
                </div>

                <div class="form-group">
                    <label class="form-label-custom">Phone Number</label>
                    <input type="text" class="form-control-custom" @bind="coPhone" placeholder="09443322110" />
                </div>

                <div class="form-group">
                    <label class="form-label-custom">Shipping Address</label>
                    <input type="text" class="form-control-custom" @bind="coAddress" placeholder="Room 21, Golden Valley Apartments" />
                </div>

                <div class="form-group">
                    <label class="form-label-custom">City</label>
                    <input type="text" class="form-control-custom" @bind="coCity" placeholder="Yangon" />
                </div>

                <h3 class="checkout-section-title mt-5">Payment Method</h3>

                <div class="payment-option @(selectedPayment == "kpay" ? "selected" : "")" @onclick='() => SelectPaymentMethod("kpay")'>
                    <input type="radio" checked="@(selectedPayment == "kpay")" readonly />
                    <div>
                        <p class="payment-option-name">KBZPay (KPay) QR Code Transfer</p>
                        <p class="payment-option-sub">Transfer to 09252522525 (The Boutique Atelier)</p>
                    </div>
                </div>

                <div class="payment-option @(selectedPayment == "wave_money" ? "selected" : "")" @onclick='() => SelectPaymentMethod("wave_money")'>
                    <input type="radio" checked="@(selectedPayment == "wave_money")" readonly />
                    <div>
                        <p class="payment-option-name">WaveMoney (WavePay) QR Transfer</p>
                        <p class="payment-option-sub">Transfer to 09252522525 (Atelier Boutique Corp.)</p>
                    </div>
                </div>

                <div class="payment-option @(selectedPayment == "cod" ? "selected" : "")" @onclick='() => SelectPaymentMethod("cod")'>
                    <input type="radio" checked="@(selectedPayment == "cod")" readonly />
                    <div>
                        <p class="payment-option-name">Cash on Delivery (Yangon Only)</p>
                        <p class="payment-option-sub">Pay raw cash to courier upon dress delivery.</p>
                    </div>
                </div>

                @if (selectedPayment == "kpay")
                {
                    <div class="qr-block">
                        <img class="qr-img" src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=KBZPayTransferRecv_09252522525" alt="KBZPay QR" />
                        <p class="qr-instruction">Scan this QR Code in KBZPay to transfer. Account Name: <span class="qr-account">Chic Boutique Atelier</span></p>
                    </div>
                }

                @if (selectedPayment == "wave_money")
                {
                    <div class="qr-block">
                        <img class="qr-img" src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=WavePayTransferRecv_09252522525" alt="WavePay QR" />
                        <p class="qr-instruction">Scan this QR Code in WaveMoney to transfer. Account Name: <span class="qr-account">Atelier Boutique Corp.</span></p>
                    </div>
                }

                @if (selectedPayment == "kpay" || selectedPayment == "wave_money")
                {
                    <div class="form-group mt-4">
                        <label class="form-label-custom">Transaction / Reference Number</label>
                        <input type="text" class="form-control-custom" @bind="paymentReference" placeholder="Enter transaction ID from payment app" />
                    </div>
                    <div class="form-group mt-4">
                        <label class="form-label-custom">Upload Screenshot Slip</label>
                        <label class="slip-upload-zone" for="payment-slip-input">
                            <i class="bi bi-cloud-arrow-up slip-upload-icon"></i>
                            <p class="slip-upload-text">Choose a JPG, PNG, or WEBP screenshot from this device</p>
                        </label>
                        <InputFile id="payment-slip-input"
                                   class="slip-file-input"
                                   OnChange="HandleSlipSelected"
                                   accept="image/jpeg,image/png,image/webp" />

                        @if (!string.IsNullOrEmpty(slipUploadError))
                        {
                            <p class="modal-error mt-2">
                                <i class="bi bi-exclamation-triangle"></i> @slipUploadError
                            </p>
                        }

                        @if (slipUploaded && !string.IsNullOrEmpty(slipFileName) && !string.IsNullOrEmpty(slipPreviewDataUrl))
                        {
                            <div class="slip-preview">
                                <img src="@slipPreviewDataUrl" style="width:120px; height:150px; object-fit:cover;" alt="Selected payment slip" />
                                <p class="slip-preview-name text-center text-success mt-2"><i class="bi bi-patch-check-fill"></i> @slipFileName</p>
                            </div>
                        }
                    </div>
                }

            </div>

            <!-- Summary info -->
                <div>
                    <h3 class="checkout-section-title">Order Bag Summary</h3>
                    <div class="order-summary-panel">
                        @if (!cart.Any())
                        {
                            <p class="text-muted text-center py-4 small">No creations in bag.</p>
                        }
                        else
                        {
                            @foreach (var item in cart)
                            {
                                <div class="order-summary-item">
                                    <FallbackImage Src="@item.ImgUrl" Alt="@item.Name" CssClass="order-summary-img" />
                                    <div>
                                        <p class="order-sum-name">@item.Name</p>
                                        <p class="order-sum-meta">@item.Size  @item.Color  Qty @item.Qty</p>
                                        <p class="order-sum-price">
                                            @if (item.DiscountAmount > 0)
                                            {
                                                <span style="text-decoration: line-through; color: var(--muted); margin-right: 8px;">@((item.Price * item.Qty).ToString("N0")) MMK</span>
                                                <span style="color: var(--charcoal); font-weight: 600;">@(((item.Price * item.Qty) - item.DiscountAmount).ToString("N0")) MMK</span>
                                                <span class="badge" style="font-size: 0.7rem; padding: 2px 6px; background-color: #fee2e2; color: #ef4444; border-radius: 4px; font-weight: 500; margin-left: 8px;">Item sale -@item.DiscountPercent.ToString("0")%</span>
                                            }
                                            else
                                            {
                                                <span>@((item.Price * item.Qty).ToString("N0")) MMK</span>
                                            }
                                        </p>
                                    </div>
                                </div>
                            }
                        }

                        <!-- Promo Code section -->
                        <div style="margin-top: 15px; border-top: 1px solid var(--border); padding-top: 15px; text-align: left;">
                            <label class="form-label-custom">Promo / Coupon Code</label>
                            <div style="display: flex; gap: 8px;">
                                <input type="text" class="form-control-custom" style="padding: 8px 12px; font-size: 0.8rem; text-transform: uppercase;" 
                                       @bind="enteredPromoCode" placeholder="Code (e.g. SUMMER20)" />
                                <button type="button" class="btn-primary-rose" style="padding: 8px 16px; font-size: 0.65rem; border-radius: 4px; letter-spacing: 0.05em; font-weight: 600;" 
                                        @onclick="ApplyPromoCodeCheckout">
                                    Apply
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(promoCodeMessage))
                            {
                                <p style="font-size: 0.72rem; margin-top: 6px; font-weight: 500; color: @(promoCodeSuccess ? "var(--success)" : "var(--red)"); margin-bottom: 0;">
                                    <i class="bi @(promoCodeSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i> @promoCodeMessage
                                </p>
                            }
                        </div>

                        <div style="border-top: 1px solid var(--border); margin-top: 15px; padding-top: 15px;">
                            <div class="summary-total-row">
                                <span class="summary-total-label">Item price (after item sale)</span>
                                <span class="summary-total-val">@CartSubtotal.ToString("N0") MMK</span>
                            </div>
                            <div class="summary-total-row" style="margin-top: 8px;">
                                <span class="summary-total-label">Shipping</span>
                                <span class="summary-total-val">3,000 MMK</span>
                            </div>
                            @if (appliedPromoDiscount > 0)
                            {
                                <div class="summary-total-row" style="margin-top: 8px; color: var(--success);">
                                    <span class="summary-total-label" style="color: var(--success); font-weight: 500;">Promo code discount</span>
                                    <span class="summary-total-val" style="color: var(--success); font-weight: 600;">-@appliedPromoDiscount.ToString("N0") MMK</span>
                                </div>
                            }
                            <div class="summary-total-row" style="border-top: 1px solid var(--border); margin-top: 12px; padding-top: 12px;">
                                <span class="summary-total-label" style="font-size: 1.1rem; font-weight: 700; color: var(--charcoal);">Total</span>
                                <span class="summary-total-val" style="font-size: 1.1rem; font-weight: 800; color: var(--rose);">@GrandTotal.ToString("N0") MMK</span>
                            </div>
                            @if (TotalSaved > 0)
                            {
                                <div style="font-size: 0.8rem; color: var(--muted); margin-top: 8px; text-align: right; font-style: italic;">
                                    You saved @TotalSaved.ToString("N0") MMK total (item sale + promo code)
                                </div>
                            }
                        </div>

                        <LoadingButton Class="btn-place-order"
                                       IsLoading="@isPlacingOrder"
                                       LoadingText="Confirming..."
                                       OnClick="PlaceOrder">
                            Confirm Atelier Purchase
                        </LoadingButton>
                    </div>
                </div>
        </div>
    </div>
    }

    
    else if (activeTab == "history")
    {
    <div class="history-view">
        <div class="section-head px-0">
            <h2 class="section-title"> <span>Your Purchases History</span></h2>
            <span class="section-count">@userOrders.Count orders logged</span>
        </div>

        <div id="history-list">
            @if (!userOrders.Any())
            {
                <p class="text-muted text-center py-5">No purchase history logged for this account. Discover creations in the catalog!</p>
            }
            else
            {
                @foreach (var order in userOrders)
                {
                    <div class="history-card @(expandedOrderId == order.OrderId ? "is-expanded" : "")">
                        <div class="history-card-header" @onclick="() => ToggleOrderDetails(order.OrderId)" style="cursor: pointer; user-select: none;">
                            <div>
                                <p class="history-order-id">Order ORD-@order.OrderId.ToString("D4")</p>
                                <p class="history-date">@(order.CreatedAt?.ToString("dd MMM yyyy HH:mm") ?? "N/A")</p>
                            </div>
                            <div>
                                @if (OrderWorkflow.Normalize(order.OrderStatus) == OrderWorkflow.Confirm)
                                {
                                    <span class="badge-confirm px-3 py-1 rounded">Confirm</span>
                                }
                                else if (OrderWorkflow.Normalize(order.OrderStatus) == OrderWorkflow.Processing)
                                {
                                    <span class="badge-processing px-3 py-1 rounded">Processing</span>
                                }
                                else if (OrderWorkflow.IsCancelled(order.OrderStatus))
                                {
                                    <span class="badge-cancelled px-3 py-1 rounded">
                                        @(OrderWorkflow.Normalize(order.OrderStatus) == OrderWorkflow.CancelledByCustomer ? "Cancellation Pending" :
                                          OrderWorkflow.Normalize(order.OrderStatus) == OrderWorkflow.CancelledByStaff ? "Cancelled (Staff)" : "Cancelled")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-pending px-3 py-1 rounded">Pending</span>
                                }
                            </div>
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span class="history-total">@order.TotalAmount.ToString("N0") MMK</span>
                                <span class="rotate-chevron @(expandedOrderId == order.OrderId ? "rotate-180" : "")" style="display: inline-flex; align-items: center; color: var(--charcoal-soft);">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="6 9 12 15 18 9"></polyline>
                                    </svg>
                                </span>
                            </div>
                        </div>

                        @if (expandedOrderId == order.OrderId)
                        {
                            <div class="order-hover-overlay" @onclick="() => ToggleOrderDetails(order.OrderId)">
                                <div class="order-hover-modal" @onclick:stopPropagation="true">
                                    <div class="order-hover-header">
                                        <div>
                                            <span class="order-hover-title">Order Details (ORD-@order.OrderId.ToString("D4"))</span>
                                            <div style="font-size: 0.75rem; color: var(--charcoal-soft); margin-top: 4px;">
                                                Placed on @(order.CreatedAt?.ToString("dd MMM yyyy HH:mm") ?? "N/A")
                                            </div>
                                        </div>
                                        <button class="order-hover-close" @onclick="() => ToggleOrderDetails(order.OrderId)">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                    <div class="order-hover-body">
                                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; margin-bottom: 24px;">
                                            <!-- Delivery details -->
                                            <div>
                                                <h5 class="order-hover-section-title">Delivery Details</h5>
                                                <p style="font-size: 0.82rem; color: var(--charcoal); margin: 0 0 6px; line-height: 1.4;">
                                                    <strong>Address:</strong> @order.ShippingAddress
                                                </p>
                                                
                                                @{
                                                    var normStatus = OrderWorkflow.Normalize(order.OrderStatus);
                                                    if (normStatus == OrderWorkflow.Confirm)
                                                    {
                                                        var confirmLog = order.StaffFulfillmentLogs?.FirstOrDefault(l => OrderWorkflow.Normalize(l.ActionTaken) == OrderWorkflow.Confirm);
                                                        var deliveryTime = confirmLog?.ActionAt ?? order.CreatedAt?.AddDays(2);
                                                        <p style="font-size: 0.82rem; color: #2e7d5e; margin: 0 0 6px; line-height: 1.4;">
                                                            <strong>Delivered on:</strong> @(deliveryTime?.ToString("dd MMM yyyy 'at' hh:mm tt") ?? "N/A")
                                                        </p>
                                                    }
                                                    else if (OrderWorkflow.IsCancelled(normStatus))
                                                    {
                                                        <p style="font-size: 0.82rem; color: #b91c1c; margin: 0 0 6px; line-height: 1.4;">
                                                            <strong>Status:</strong> @(normStatus == OrderWorkflow.CancelledByCustomer ? "Cancellation Pending" :
                                                                                       normStatus == OrderWorkflow.CancelledByStaff ? "Cancelled (Staff)" : "Cancelled")
                                                        </p>
                                                    }
                                                    else
                                                    {
                                                        var estDeliveryTime = order.CreatedAt?.AddDays(3);
                                                        <p style="font-size: 0.82rem; color: #c07826; margin: 0 0 6px; line-height: 1.4;">
                                                            <strong>Estimated Delivery:</strong> @(estDeliveryTime?.ToString("dd MMM yyyy") ?? "N/A") (within 3 days)
                                                        </p>
                                                    }
                                                }
                                            </div>

                                            <!-- Payment details -->
                                            <div>
                                                <h5 class="order-hover-section-title">Payment Details</h5>
                                                @{
                                                    var payment = order.Payments?.FirstOrDefault();
                                                    if (payment != null)
                                                    {
                                                        <p style="font-size: 0.82rem; color: var(--charcoal); margin: 0 0 6px; line-height: 1.4;">
                                                            <strong>Method:</strong> @(payment.PaymentMethod == "cod" ? "Cash on Delivery" : payment.PaymentMethod.ToUpperInvariant())
                                                        </p>
                                                        <p style="font-size: 0.82rem; color: var(--charcoal); margin: 0 0 6px; line-height: 1.4;">
                                                            <strong>Transaction ID:</strong> @(payment.TransactionId ?? "N/A")
                                                        </p>
                                                        <p style="font-size: 0.82rem; color: var(--charcoal); margin: 0 0 6px; line-height: 1.4;">
                                                            <strong>Status:</strong> <span style="text-transform: capitalize;">@payment.PaymentStatus</span>
                                                        </p>
                                                    }
                                                    else
                                                    {
                                                        <p style="font-size: 0.82rem; color: var(--charcoal-soft); margin: 0;">No payment information available.</p>
                                                    }
                                                }
                                            </div>
                                        </div>

                                        <!-- Action Buttons -->
                                        @if (OrderWorkflow.Normalize(order.OrderStatus) != OrderWorkflow.Confirm && !OrderWorkflow.IsCancelled(order.OrderStatus))
                                        {
                                            <div style="margin-bottom: 24px; display: flex; justify-content: flex-end;">
                                                <button class="btn-cancel-order" @onclick="() => OpenCancelModal(order.OrderId)" @onclick:stopPropagation="true">
                                                    Cancel Order
                                                </button>
                                            </div>
                                        }
                                        else if (OrderWorkflow.Normalize(order.OrderStatus) == OrderWorkflow.Confirm && CanRequestReturn(order) && !userReturns.Any(r => r.OrderId == order.OrderId && !string.Equals(r.Status, "Rejected", StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <div style="margin-bottom: 24px; display: flex; justify-content: flex-end;">
                                                <button class="btn-primary-rose" @onclick="() => InitiateReturn(order)" @onclick:stopPropagation="true" style="padding: 10px 24px; font-size: 0.72rem;">
                                                    Request Return / Exchange
                                                </button>
                                            </div>
                                        }

                                        <!-- Items List -->
                                        <h5 class="order-hover-section-title">Creations Ordered</h5>
                                        <div class="history-items" style="padding: 0;">
                                            @foreach (var item in order.OrderItems)
                                            {
                                                var imgObj = item.Variant?.Product?.ProductImages?.FirstOrDefault(i => i.IsPrimary == true);
                                                var primaryImg = NormalizeImageUrl(imgObj?.ImageUrl);
                                                @if (item.Variant != null)
                                                {
                                                    <div class="history-item-row" style="padding: 12px 8px;">
                                                        <FallbackImage Src="@primaryImg" Alt="@(item.Variant?.Product?.Name ?? "Product")" CssClass="history-item-img" style="width: 55px; height: 75px;" />
                                                        <div>
                                                            <h4 class="history-item-name" style="font-size: 0.9rem; font-weight: 500;">@(item.Variant?.Product?.Name ?? "Unknown Product")</h4>
                                                            <p class="history-item-meta" style="font-size: 0.72rem; margin-top: 2px;">
                                                                Size: @(item.Variant?.Size ?? "-") &middot;
                                                                Color: @(item.Variant?.Color ?? "-") &middot;
                                                                Qty: @item.Quantity
                                                            </p>
                                                            <p class="history-item-price" style="font-size: 0.8rem; margin-top: 3px;">@((item.PriceAtPurchase * item.Quantity).ToString("N0")) MMK</p>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="history-item-row" style="padding: 12px 8px;">
                                                        <FallbackImage Src="@primaryImg" Alt="Product" CssClass="history-item-img" style="width: 55px; height: 75px;" />
                                                        <div>
                                                            <h4 class="history-item-name" style="font-size: 0.9rem; font-weight: 500;">Unknown Product</h4>
                                                            <p class="history-item-meta" style="font-size: 0.72rem; margin-top: 2px;">
                                                                Qty: @item.Quantity
                                                            </p>
                                                            <p class="history-item-price" style="font-size: 0.8rem; margin-top: 3px;">@((item.PriceAtPurchase * item.Quantity).ToString("N0")) MMK</p>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>

                                        <div style="margin-top: 16px; border-top: 1px solid var(--border); padding-top: 12px;">
                                            @{
                                                var subTotal = order.OrderItems.Sum(item => item.PriceAtPurchase * item.Quantity);
                                                var discount = subTotal - order.TotalAmount;
                                            }
                                            @if (discount > 0)
                                            {
                                                <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--charcoal-soft); margin-bottom: 6px;">
                                                    <span>Subtotal</span>
                                                    <span>@subTotal.ToString("N0") MMK</span>
                                                </div>
                                                <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: #b91c1c; margin-bottom: 6px;">
                                                    <span>Discount @(!string.IsNullOrEmpty(order.AppliedPromo) ? $"({order.AppliedPromo})" : "")</span>
                                                    <span>- @discount.ToString("N0") MMK</span>
                                                </div>
                                            }
                                            <div style="display: flex; justify-content: space-between; font-size: 0.95rem; font-weight: 600; color: var(--charcoal); margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--border);">
                                                <span>Total Amount</span>
                                                <span style="color: var(--rose);">@order.TotalAmount.ToString("N0") MMK</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
    }

    else if (activeTab == "return")
    {
    <div class="checkout-view" style="max-width: 800px; margin: 0 auto; padding: 50px 20px;">
        <h2 class="section-title mb-4">Request <span>Return / Exchange</span></h2>
        
        @if (selectedReturnOrder == null)
        {
            <div class="alert alert-warning text-center py-5" style="background: var(--rose-pale); border: 1px solid var(--rose-light); color: var(--charcoal); border-radius: 12px;">
                <i class="bi bi-exclamation-triangle" style="font-size: 2rem; display: block; margin-bottom: 12px; color: var(--rose);"></i>
                You do not have any delivered orders eligible for return or exchange yet. Discover creations in the catalog!
            </div>
        }
        else
        {
            <div class="order-summary-panel" style="padding: 30px; border-radius: 12px; background: var(--white); box-shadow: var(--shadow-lg);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
                    <div>
                        <span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; color: var(--charcoal); letter-spacing: 0.05em;">Order ORD-@selectedReturnOrder.OrderId.ToString("D4")</span>
                        <p class="mb-0" style="font-size: 0.78rem; color: var(--charcoal-soft); margin-top: 4px;">Order Date: @(selectedReturnOrder.CreatedAt?.ToString("dd MMM yyyy") ?? "N/A")</p>
                    </div>
                    <button class="btn btn-cancel" style="background: var(--off-white); border: 1px solid var(--border); color: var(--charcoal); padding: 8px 16px; font-family: 'DM Sans', sans-serif; font-size: 0.72rem; cursor: pointer; text-transform: uppercase;" @onclick='() => Navigate("history")'>Back to History</button>
                </div>

                <!-- Select Order Dropdown -->
                <div class="form-group mb-4" style="text-align: left;">
                    <label class="form-label-custom">Select Order to Return / Exchange</label>
                    <select class="form-control-custom" style="border-radius: 8px; font-family: 'DM Sans', sans-serif;" @onchange="OnReturnOrderChanged">
                        @foreach (var order in userOrders.Where(o => CanSelectForReturn(o)))
                        {
                            <option value="@order.OrderId" selected="@(selectedReturnOrder?.OrderId == order.OrderId)">
                                Order ORD-@order.OrderId.ToString("D4") (Date: @(order.CreatedAt?.ToString("dd MMM yyyy") ?? "N/A"))
                            </option>
                        }
                    </select>
                </div>

                @if (CanRequestReturn(selectedReturnOrder))
                {
                    <!-- Select Item to Return -->
                    @if (selectedReturnOrder.OrderItems != null && selectedReturnOrder.OrderItems.Any(oi => !HasBeenReturned(selectedReturnOrder.OrderId, oi.VariantId)))
                    {
                        <div class="form-group mb-4" style="text-align: left;">
                            <label class="form-label-custom">Select Item to Return / Exchange</label>
                            <select class="form-control-custom" style="border-radius: 8px; font-family: 'DM Sans', sans-serif;" value="@selectedReturnItemId" @onchange="OnReturnItemChanged">
                                @foreach (var item in selectedReturnOrder.OrderItems.Where(oi => !HasBeenReturned(selectedReturnOrder.OrderId, oi.VariantId)))
                                {
                                    <option value="@item.OrderItemId">
                                        @(item.Variant?.Product?.Name ?? "Product") (Size: @(item.Variant?.Size ?? "-"), Color: @(item.Variant?.Color ?? "-"), Qty: @item.Quantity)
                                    </option>
                                }
                            </select>
                        </div>
                    }

                    <!-- Show Item Preview -->
                    @if (selectedReturnItem != null)
                    {
                        var imgObj = selectedReturnItem.Variant?.Product?.ProductImages?.FirstOrDefault(i => i.IsPrimary == true);
                        var itemImg = NormalizeImageUrl(imgObj?.ImageUrl);
                        <div style="display: flex; gap: 16px; background: var(--rose-pale); padding: 16px; border-radius: 8px; margin-bottom: 24px; text-align: left;">
                            <FallbackImage Src="@itemImg" Alt="Product Image" style="width: 60px; height: 80px; object-fit: cover; border-radius: 4px;" />
                            <div style="display: flex; flex-direction: column; justify-content: center;">
                                <h4 style="font-family: 'DM Sans', sans-serif; font-size: 0.95rem; font-weight: 600; color: var(--charcoal); margin-bottom: 4px;">@(selectedReturnItem.Variant?.Product?.Name ?? "Product")</h4>
                                <p style="font-size: 0.78rem; color: var(--charcoal-soft); margin-bottom: 0;">Size: @(selectedReturnItem.Variant?.Size ?? "-") &middot; Color: @(selectedReturnItem.Variant?.Color ?? "-") &middot; Qty: @selectedReturnItem.Quantity</p>
                                <p style="font-size: 0.85rem; font-weight: 600; color: var(--rose); margin-top: 4px; margin-bottom: 0;">@((selectedReturnItem.PriceAtPurchase * selectedReturnItem.Quantity).ToString("N0")) MMK</p>
                            </div>
                        </div>
                    }

                    <!-- Receipt Upload -->
                    <div class="form-group mb-4" style="text-align: left;">
                        <label class="form-label-custom">Upload Receipt / Bill Image</label>
                        <label class="slip-upload-zone" for="return-receipt-input" style="border-radius: 8px; padding: 24px; border: 2px dashed var(--rose-light);">
                            <i class="bi bi-cloud-arrow-up slip-upload-icon" style="font-size: 1.8rem; margin-bottom: 8px; color: var(--rose-light);"></i>
                            <p class="slip-upload-text" style="font-size: 0.75rem; color: var(--charcoal-soft);">Choose a JPG, PNG, or WEBP receipt file</p>
                        </label>
                        <InputFile id="return-receipt-input"
                                   class="slip-file-input"
                                   OnChange="HandleReturnReceiptSelected"
                                   accept="image/jpeg,image/png,image/webp" />

                        @if (!string.IsNullOrEmpty(returnReceiptError))
                        {
                            <p class="modal-error mt-2" style="color: var(--red);">
                                <i class="bi bi-exclamation-triangle"></i> @returnReceiptError
                            </p>
                        }

                        @if (returnReceiptBytes != null && !string.IsNullOrEmpty(returnReceiptFileName) && !string.IsNullOrEmpty(returnReceiptPreviewUrl))
                        {
                            <div class="slip-preview" style="margin-top: 14px; text-align: center;">
                                <img src="@returnReceiptPreviewUrl" style="width: 110px; height: 140px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border);" alt="Receipt slip" />
                                <p class="slip-preview-name text-center text-success mt-2" style="font-size: 0.72rem; color: var(--success);"><i class="bi bi-patch-check-fill"></i> @returnReceiptFileName</p>
                            </div>
                        }
                    </div>

                    <!-- Predefined Reasons (Checkboxes) -->
                    <div class="form-group mb-4" style="text-align: left;">
                        <label class="form-label-custom">Reason for Return (Select at least one checkbox OR type below)</label>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 8px;">
                            <label style="display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--charcoal); cursor: pointer;">
                                <input type="checkbox" @bind="retReasonColorMismatch" style="accent-color: var(--rose); width: 16px; height: 16px;" />
                                Color didn't match
                            </label>
                            <label style="display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--charcoal); cursor: pointer;">
                                <input type="checkbox" @bind="retReasonDamage" style="accent-color: var(--rose); width: 16px; height: 16px;" />
                                Damage order
                            </label>
                            <label style="display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--charcoal); cursor: pointer;">
                                <input type="checkbox" @bind="retReasonSizeIssue" style="accent-color: var(--rose); width: 16px; height: 16px;" />
                                Size issue
                            </label>
                            <label style="display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--charcoal); cursor: pointer;">
                                <input type="checkbox" @bind="retReasonExchangeRequest" style="accent-color: var(--rose); width: 16px; height: 16px;" />
                                Want to exchange with other item
                            </label>
                        </div>
                    </div>

                    <!-- Text message box -->
                    <div class="form-group mb-4" style="text-align: left;">
                        <label class="form-label-custom">Additional Details / Custom Message</label>
                        <textarea class="form-control-custom" style="min-height: 100px; border-radius: 8px; resize: vertical; font-family: 'DM Sans', sans-serif;" 
                                  placeholder="Describe your issue or what item you want to exchange with..." 
                                  @bind="returnCustomMessage"></textarea>
                    </div>

                    <!-- Return Option (Refund / Exchange) -->
                    <div class="form-group mb-4" style="text-align: left;">
                        <label class="form-label-custom">Choose Option</label>
                        <div style="display: flex; gap: 24px; margin-top: 8px;">
                            <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--charcoal); cursor: pointer;">
                                <input type="radio" name="return_option" checked='@(returnOption == "Refund")' @onclick='() => returnOption = "Refund"' style="accent-color: var(--rose); width: 18px; height: 18px;" />
                                Take Money Back (Refund)
                            </label>
                            <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--charcoal); cursor: pointer;">
                                <input type="radio" name="return_option" checked='@(returnOption == "Exchange")' @onclick='() => returnOption = "Exchange"' style="accent-color: var(--rose); width: 18px; height: 18px;" />
                                Exchange with Other Item
                            </label>
                        </div>
                    </div>

                    @if (returnOption == "Exchange")
                    {
                        <div style="background: var(--rose-pale); border: 1px dashed var(--rose-light); padding: 20px; border-radius: 8px; margin-bottom: 24px; text-align: left;">
                            <h4 style="font-family: 'DM Sans', sans-serif; font-size: 0.9rem; font-weight: 600; color: var(--charcoal); margin-bottom: 12px; margin-top: 0;">Exchange Item Details</h4>
                            
                            @if (selectedExchangeVariant == null)
                            {
                                <p style="font-size: 0.8rem; color: var(--charcoal-soft); margin-bottom: 12px;">Please select the creation you would like to exchange your item with.</p>
                                <button type="button" class="btn btn-primary-rose" style="font-size: 0.72rem; padding: 8px 16px; cursor: pointer; text-transform: uppercase;" @onclick="() => showExchangePicker = true">
                                    <i class="bi bi-search"></i> Select Replacement Item
                                </button>
                            }
                            else
                            {
                                 var matchingProduct = allProducts.FirstOrDefault(p => p.ProductId == selectedExchangeVariant.ProductId);
                                 var imgObj = matchingProduct?.ProductImages?.FirstOrDefault(i => i.IsPrimary == true);
                                 var replacementImg = NormalizeImageUrl(imgObj?.ImageUrl);
                                 <div style="display: flex; gap: 16px; align-items: center; margin-bottom: 12px;">
                                     <FallbackImage Src="@replacementImg" Alt="Replacement Product" style="width: 50px; height: 65px; object-fit: cover; border-radius: 4px;" />
                                     <div style="display: flex; flex-direction: column;">
                                         <span style="font-size: 0.65rem; color: var(--rose); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Replacement Selection</span>
                                         <h5 style="font-family: 'DM Sans', sans-serif; font-size: 0.9rem; font-weight: 600; color: var(--charcoal); margin: 2px 0;">@(matchingProduct?.Name ?? "Product")</h5>
                                        <p style="font-size: 0.75rem; color: var(--charcoal-soft); margin: 0;">Size: @selectedExchangeVariant.Size &middot; Color: @selectedExchangeVariant.Color</p>
                                        <p style="font-size: 0.82rem; font-weight: 600; color: var(--rose); margin-top: 2px; margin-bottom: 0;">@(selectedExchangeVariant.SalePrice?.ToString("N0") ?? "0") MMK</p>
                                    </div>
                                </div>
                                <button type="button" class="btn" style="background: var(--white); border: 1px solid var(--border); color: var(--charcoal-soft); font-size: 0.7rem; padding: 6px 12px; cursor: pointer; border-radius: 4px;" @onclick="() => showExchangePicker = true">
                                    Change Selection
                                </button>
                            }
                        </div>
                    }

                    <!-- Submit Button -->
                    <LoadingButton Class="btn-primary-rose"
                                   IsLoading="@isSubmittingReturn"
                                   LoadingText="Submitting..."
                                   OnClick="SubmitReturnRequest"
                                   style="width: 100%; padding: 16px; border-radius: 8px; margin-top: 12px;">
                        Submit Return / Exchange Request
                    </LoadingButton>
                }

                <!-- Previously Returned Items Section -->
                @{
                    var returnedItems = selectedReturnOrder.OrderItems
                        .Where(oi => HasBeenReturned(selectedReturnOrder.OrderId, oi.VariantId, out _))
                        .ToList();
                }

                @if (returnedItems.Any())
                {
                    <div style="margin-top: 30px; border-top: 1px solid var(--border); padding-top: 24px; text-align: left;">
                        <h4 style="font-family: 'DM Sans', sans-serif; font-size: 0.95rem; font-weight: 600; color: var(--charcoal); margin-bottom: 12px;">
                            <i class="bi bi-clock-history" style="color: var(--rose); margin-right: 6px;"></i> Already Returned Creations in this Order
                        </h4>
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            @foreach (var item in returnedItems)
                            {
                                string option = "";
                                HasBeenReturned(selectedReturnOrder.OrderId, item.VariantId, out option);
                                var imgObj = item.Variant?.Product?.ProductImages?.FirstOrDefault(i => i.IsPrimary == true);
                                var itemImg = NormalizeImageUrl(imgObj?.ImageUrl);

                                <div style="display: flex; justify-content: space-between; align-items: center; background: #fafafa; border: 1px solid var(--border); padding: 12px 16px; border-radius: 8px;">
                                    <div style="display: flex; gap: 12px; align-items: center;">
                                        <FallbackImage Src="@itemImg" Alt="Product Image" style="width: 40px; height: 55px; object-fit: cover; border-radius: 4px;" />
                                        <div>
                                            <h5 style="font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 600; color: var(--charcoal); margin: 0 0 2px 0;">@(item.Variant?.Product?.Name ?? "Product")</h5>
                                            <p style="font-size: 0.72rem; color: var(--charcoal-soft); margin: 0;">Size: @(item.Variant?.Size ?? "-") &middot; Color: @(item.Variant?.Color ?? "-") &middot; Qty: @item.Quantity</p>
                                        </div>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        @{
                                            var retObj = GetOrderReturn(selectedReturnOrder.OrderId, item.VariantId);
                                        }
                                        @if (!string.IsNullOrEmpty(retObj?.ReceiptImageUrl))
                                        {
                                            <a href="@retObj.ReceiptImageUrl" target="_blank" title="View Uploaded Receipt" style="display: block;">
                                                <img src="@retObj.ReceiptImageUrl" alt="Receipt Preview" style="width: 38px; height: 50px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border); cursor: zoom-in;" />
                                            </a>
                                        }
                                        <span class="badge" style="background: rgba(212,178,167,0.15); color: var(--rose); border: 1px solid rgba(212,178,167,0.3); padding: 4px 10px; border-radius: 12px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase;">
                                            @option (@(retObj?.Status ?? "Pending"))
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    }

    else if (activeTab == "profile")
    {
        if (currentUser == null)
        {
            <div class="history-card" >
                <div class="section-head px-0">
                    <h2 class="section-title">Your <span>Authentication required. Please log in to access your profile page.</span></h2>
                    <button class="nav-tab text-danger" @onclick="GotoLogin" style="margin-left: auto;">Login</button>
                </div>
            </div>

        }
        else
        {
            <div class="profile-view">
                <div class="profile-grid">
                    <!-- Member Badge Card -->
                    <div class="profile-card">
                        <div class="profile-avatar-wrap">
                            <img src="@profileAvatar" alt="Avatar" />
                        </div>

                        <h3 class="profile-name-display">@currentUser?.FirstName @currentUser?.LastName</h3>

                        @if (loyaltyPoints >= 1500)
                        {
                            <span class="profile-tier-badge" style="background:#D4AF37;">Royal Circle (Gold)</span>
                        }
                        else if (loyaltyPoints >= 500)
                        {
                            <span class="profile-tier-badge" style="background:#C0C0C0;">Atelier Elite (Silver)</span>
                        }
                        else
                        {
                            <span class="profile-tier-badge">Salon Member (Bronze)</span>
                        }

                        <p class="profile-joined">Joined On: @(currentUser?.CreatedAt?.ToString("MMM yyyy") ?? "June 2026")</p>

                        <div class="loyalty-points-box">
                            <div class="points-header">
                                <span class="points-label">Loyalty Balance</span>
                                <span class="points-value">@loyaltyPoints.ToString("N0") pts</span>
                            </div>

                            @{
                                int nextTierTarget = 1500;
                                int ptsNeeded = nextTierTarget - loyaltyPoints;
                                double progressPercent = (double)loyaltyPoints / nextTierTarget * 100;
                                if (progressPercent > 100) progressPercent = 100;
                            }

                            <div class="points-progress-bar">
                                <div class="points-progress-fill" style="width: @(progressPercent)%;"></div>
                            </div>
                            <div class="points-footer">
                                @if (ptsNeeded > 0)
                                {
                                    <span>@ptsNeeded.ToString("N0") pts to Gold Member</span>
                                }
                                else
                                {
                                    <span>Maximum Membership Tier Achieved</span>
                                }
                                <span>Target: @nextTierTarget pts</span>
                            </div>
                        </div>

                        <div class="alert bg-light border text-start p-3 small" style="line-height: 1.6;">
                            <strong>? Membership Privileges:</strong>
                            <ul class="ps-3 mt-1 m-0">
                                <li>Earn 1 Point for every 5000 MMK spent.</li>
                                <li>Silver members get 5% off items automatically.</li>
                                <li>Gold members unlock free shipping & early access.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Edit Profile Form -->
                    <div class="profile-card text-start">
                        <h3 class="checkout-section-title">Atelier Member Details</h3>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="form-label-custom">First Name</label>
                                <input type="text" class="form-control-custom" @bind="profFirstName" />
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="form-label-custom">Last Name</label>
                                <input type="text" class="form-control-custom" @bind="profLastName" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label-custom">Email Address (Registered)</label>
                            <input type="email" class="form-control-custom" @bind="profEmail" />
                        </div>

                        <div class="form-group">
                            <label class="form-label-custom">Phone Number</label>
                            <input type="text" class="form-control-custom" @bind="coPhone" />
                        </div>

                        <div class="form-group">
                            <label class="form-label-custom">Default Delivery Address</label>
                            <input type="text" class="form-control-custom" @bind="profAddress" />
                        </div>

                        <div class="form-group">
                            <label class="form-label-custom">Default City</label>
                            <input type="text" class="form-control-custom" @bind="profCity" />
                        </div>

                        <LoadingButton Class="btn-primary-rose mt-4 w-100"
                                                       IsLoading="@isSavingCustomerProfile"
                                                       LoadingText="Saving..."
                                                       OnClick="SaveProfile">
                            Save Member Profile
                        </LoadingButton>
                    </div>
                </div>
            </div>
        }
    }
    else if (activeTab == "notification-detail")
    {
        @if (selectedNotification != null)
        {
            <div class="noti-detail-container">
                <div class="noti-detail-header">
                    <button class="btn-back" @onclick="GoBackFromNotification">
                        <i class="bi bi-arrow-left-short"></i> Back to Atelier
                    </button>
                </div>

                <div class="noti-detail-card">
                    <!-- Notification Icon and Metadata -->
                    <div class="noti-card-header">
                        <div class="noti-icon-wrapper @(selectedNotification.Title.Contains("Confirmed", StringComparison.OrdinalIgnoreCase) ? "confirmed" : 
                                                         selectedNotification.Title.Contains("Cancel", StringComparison.OrdinalIgnoreCase) ? "cancelled" : "info")">
                            @if (selectedNotification.Title.Contains("Confirmed", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-check-circle"></i>
                            }
                            else if (selectedNotification.Title.Contains("Cancel", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-x-circle"></i>
                            }
                            else
                            {
                                <i class="bi bi-bell"></i>
                            }
                        </div>
                        <div class="noti-meta-info">
                            <h2 class="noti-title">@selectedNotification.Title</h2>
                            <span class="noti-date"><i class="bi bi-calendar3"></i> @selectedNotification.CreatedAt.ToString("dd-MMM-yyyy hh:mm tt")</span>
                        </div>
                    </div>

                    <div class="noti-divider"></div>

                    <!-- Message Content -->
                    <div class="noti-card-body">
                        <div class="noti-message-bubble">
                            <p class="noti-message-text">@selectedNotification.Message</p>
                        </div>
                    </div>

                    <!-- Action Area -->
                    <div class="noti-card-footer">
                        @if (selectedNotification.OrderId.HasValue)
                        {
                            <div class="action-buttons-group">
                                @if (selectedNotification.Title.Contains("Confirmed", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="btn-primary-action" @onclick="ViewReceiptFromNotification">
                                        <i class="bi bi-receipt-cutoff"></i> View Official Receipt
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-primary-action" @onclick="ViewPurchasesFromNotification">
                                        <i class="bi bi-bag-heart"></i> View My Purchases
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <button class="btn-secondary-action" @onclick="GoBackFromNotification">
                                Return to Atelier
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else if (activeTab == "promotions")
    {
        @if (selectedPromotionDetail == null)
        {
            var dealOfMoment = promotionsList.FirstOrDefault(p => p.DiscountPercent > 0) ?? promotionsList.FirstOrDefault();
            var filteredPromos = promotionsList.Where(p => {
                if (selectedPromoFilter == "All") return true;
                if (selectedPromoFilter == "Dresses") return p.Title.Contains("Summer", StringComparison.OrdinalIgnoreCase) || p.Description.Contains("linen", StringComparison.OrdinalIgnoreCase) || p.Title.Contains("Dresses", StringComparison.OrdinalIgnoreCase) || p.Title.Contains("Points", StringComparison.OrdinalIgnoreCase);
                if (selectedPromoFilter == "Blouses") return p.Title.Contains("Silhouette", StringComparison.OrdinalIgnoreCase) || p.Description.Contains("silk", StringComparison.OrdinalIgnoreCase) || p.Title.Contains("Blouses", StringComparison.OrdinalIgnoreCase) || p.Title.Contains("Points", StringComparison.OrdinalIgnoreCase);
                if (selectedPromoFilter == "Delivery") return p.Title.Contains("Delivery", StringComparison.OrdinalIgnoreCase) || p.Title.Contains("Monsoon", StringComparison.OrdinalIgnoreCase) || p.Description.Contains("dispatch", StringComparison.OrdinalIgnoreCase);
                return false;
            }).ToList();

            <div class="promo-container">
                <div class="wrap">
                    <section class="hero">
                        <div class="hero-content">
                            <div class="eyebrow">Atelier Offers</div>
                            <h1>Curated savings on <em>this season's</em> pieces.</h1>
                            <p class="lede">Seasonal codes across dresses, blouses and delivery, refreshed weekly and honoured at checkout.</p>
                            <div class="stats">
                                <div class="stat"><span class="num">@promotionsList.Count</span><span class="label">Live Offers</span></div>
                                <div class="stat"><span class="num">@TotalCodesRedeemed</span><span class="label">Codes Redeemed</span></div>
                                <div class="stat"><span class="num">@NewArrivalsCount</span><span class="label">New This Week</span></div>
                            </div>
                            <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.15); display: flex; flex-direction: column; gap: 8px;">
                                <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: rgba(255,255,255,0.7);">Available Promo Codes</div>
                                <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                                    @foreach (var p in couponsList.Where(p => !string.IsNullOrEmpty(p.PromoCode)))
                                    {
                                        var displayLabel = p.PromoType switch
                                        {
                                            "Percent" => $"{(int)p.DiscountValue}% Off",
                                            "Fixed" => $"{p.DiscountValue:N0} ks Off",
                                            "Shipping" => "Free Shipping",
                                            _ => p.DiscountPercent > 0 ? $"{(int)p.DiscountPercent}% Off" : "Double Points"
                                        };
                                        <div style="font-family: monospace; font-size: 0.85rem; background: rgba(255, 255, 255, 0.1); border: 1.5px dashed rgba(255, 255, 255, 0.5); padding: 6px 12px; border-radius: 6px; font-weight: 700; color: #ffffff; cursor: pointer; transition: all 0.2s;" 
                                             @onclick="() => CopyPromoCode(p.PromoCode)" @onclick:stopPropagation="true" title="Click to copy code">
                                            @p.PromoCode (@displayLabel)
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </section>

                    <div class="filters" role="tablist" aria-label="Filter offers by category">
                        <button class="pill @(selectedPromoFilter == "All" ? "active" : "")" @onclick='() => selectedPromoFilter = "All"'>All Offers</button>
                        <button class="pill @(selectedPromoFilter == "Dresses" ? "active" : "")" @onclick='() => selectedPromoFilter = "Dresses"'>Dresses</button>
                        <button class="pill @(selectedPromoFilter == "Blouses" ? "active" : "")" @onclick='() => selectedPromoFilter = "Blouses"'>Blouses</button>
                        <button class="pill @(selectedPromoFilter == "Delivery" ? "active" : "")" @onclick='() => selectedPromoFilter = "Delivery"'>Delivery</button>
                    </div>

                    @if (dealOfMoment != null)
                    {
                        var daysLeft = dealOfMoment.EndDate.HasValue ? (dealOfMoment.EndDate.Value - DateTime.Now).Days : -1;
                        var durationText = daysLeft > 0 ? $"Ends in {daysLeft}d" : "Ongoing";
                        var subText = string.IsNullOrEmpty(dealOfMoment.Subtitle) ? durationText : $"{dealOfMoment.Subtitle} · {durationText}";
                        var hasBgStyle = !string.IsNullOrEmpty(dealOfMoment.ImageUrl) || !string.IsNullOrEmpty(dealOfMoment.GradientCss);
                        var bgStyle = !string.IsNullOrEmpty(dealOfMoment.ImageUrl) 
                            ? $"background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('{dealOfMoment.ImageUrl}') center/cover no-repeat; color: #FFF3EE;" 
                            : (!string.IsNullOrEmpty(dealOfMoment.GradientCss) 
                                ? $"background: {dealOfMoment.GradientCss}; color: #FFF3EE;" 
                                : "");

                        <div class="deal-of-moment" style="cursor: pointer; @bgStyle" @onclick="() => SelectPromotion(dealOfMoment)">
                            <div class="dom-left">
                                <div class="seal">CB</div>
                                <div>
                                    <div class="dom-tag" style="@(hasBgStyle ? "color: var(--gold-light);" : "")">Deal of the Moment</div>
                                    <h3 class="dom-title" style="@(hasBgStyle ? "color: #FFF3EE;" : "")">@(dealOfMoment.DiscountPercent > 0 ? $"{(int)dealOfMoment.DiscountPercent}% Off" : "Special Offer") — @dealOfMoment.Title</h3>
                                    <div class="dom-sub" style="@(hasBgStyle ? "color: rgba(255,255,255,0.75);" : "")">@subText</div>
                                </div>
                            </div>
                            <div class="dom-right">
                                @if (!string.IsNullOrEmpty(dealOfMoment.PromoCode))
                                {
                                    <div class="code-box">@dealOfMoment.PromoCode</div>
                                    <button class="copy-btn" @onclick="() => CopyPromoCode(dealOfMoment.PromoCode)" @onclick:stopPropagation="true">Copy Code</button>
                                }
                            </div>
                        </div>
                    }

                    <div class="grid">
                        @for (int i = 0; i < filteredPromos.Count; i++)
                        {
                            var promo = filteredPromos[i];
                            var daysLeft = promo.EndDate.HasValue ? (promo.EndDate.Value - DateTime.Now).Days : -1;
                            var durationText = daysLeft > 0 ? $"Ends in {daysLeft}d" : "Ongoing";
                            var cardClass = $"c{(i % 4) + 1}";
                            var hasBgStyle = !string.IsNullOrEmpty(promo.ImageUrl) || !string.IsNullOrEmpty(promo.GradientCss);
                            var bgStyle = !string.IsNullOrEmpty(promo.ImageUrl) 
                                ? $"background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('{promo.ImageUrl}') center/cover no-repeat; color: #FFF3EE;" 
                                : (!string.IsNullOrEmpty(promo.GradientCss) 
                                    ? $"background: {promo.GradientCss}; color: #FFF3EE;" 
                                    : "");

                            <div class="card @cardClass" style="@bgStyle" @onclick="() => SelectPromotion(promo)">
                                <div class="card-top">
                                    <span class="badge">@(promo.DiscountPercent > 0 ? $"{(int)promo.DiscountPercent}% Off" : "Special Offer")</span>
                                    <span class="badge end">@durationText</span>
                                </div>
                                <div class="card-icon" style="@(hasBgStyle ? "color: var(--gold-light); opacity: 0.95;" : "")">
                                    @if (i % 4 == 0)
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                                    }
                                    else if (i % 4 == 1)
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 20V11a8 8 0 0 1 16 0v9"/><rect x="3" y="15" width="4" height="6" rx="1.5"/><rect x="17" y="15" width="4" height="6" rx="1.5"/></svg>
                                    }
                                    else if (i % 4 == 2)
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 8h11v9H2z"/><path d="M13 11h4l4 3v3h-8z"/><circle cx="6" cy="19" r="1.6"/><circle cx="17" cy="19" r="1.6"/></svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="9" width="18" height="12" rx="1.5"/><path d="M3 13h18"/><path d="M12 9v12"/><path d="M8 9c-1.5 0-2.5-1-2.5-2.2S6.7 5 8 5c1.8 0 4 1.8 4 4"/><path d="M16 9c1.5 0 2.5-1 2.5-2.2S15.3 5 14 5c-1.8 0-4 1.8-4 4"/></svg>
                                    }
                                </div>
                                <div class="card-title" style="@(hasBgStyle ? "color: #FFF3EE;" : "")">@promo.Title</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="checkout-view" style="max-width: 1100px; margin: 0 auto; padding: 40px 20px;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <button class="btn-back" style="border-radius: 8px; font-size: 0.75rem; text-transform: uppercase; font-weight: 600;" @onclick="() => selectedPromotionDetail = null">
                            <i class="bi bi-arrow-left"></i> Back to All Offers
                        </button>
                        <h2 class="section-title mt-3 mb-1" style="font-size: 1.75rem;">@selectedPromotionDetail.Title</h2>
                        <span style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--rose); letter-spacing: 0.05em;">Active Coupon: @selectedPromotionDetail.PromoCode (@selectedPromotionDetail.Subtitle)</span>
                    </div>
                    <div style="background: var(--rose-pale); border: 1px solid var(--rose-light); border-radius: 8px; padding: 12px 20px; text-align: right; max-width: 320px;">
                        <p style="font-size: 0.75rem; color: var(--charcoal-soft); margin: 0; line-height: 1.4;">@selectedPromotionDetail.Description</p>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 24px;">
                    @foreach (var prod in allProducts.Where(p => p.PromoId == selectedPromotionDetail.PromoId))
                    {
                        var primaryImg = NormalizeImageUrl(prod.ProductImages?.FirstOrDefault(i => i.IsPrimary == true)?.ImageUrl);
                        var originalPrice = prod.ProductVariants?.FirstOrDefault()?.SalePrice ?? 0;
                        var hasDiscount = selectedPromotionDetail.DiscountPercent > 0;
                        var discountedPrice = hasDiscount ? originalPrice * (1 - selectedPromotionDetail.DiscountPercent / 100) : originalPrice;

                        // Mock ratings for realism
                        var mockRating = 4.5 + (prod.ProductId % 6) * 0.1;
                        var mockReviewCount = 12 + (prod.ProductId * 7) % 85;

                        <div class="promo-grid-card">
                            <div class="promo-grid-img-wrap" style="cursor: pointer;" @onclick="() => OpenQuickViewFromProduct(prod)">
                                <FallbackImage Src="@primaryImg" Alt="@prod.Name" />
                            </div>
                            
                            <h3 class="promo-grid-title">@prod.Name</h3>
                            <p style="font-size: 0.7rem; color: var(--rose); font-weight: 600; text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.04em;">@prod.Category?.Name</p>

                            <!-- Star Rating -->
                            <div class="promo-grid-rating">
                                <span class="promo-grid-stars">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        if (s <= Math.Round(mockRating))
                                        {
                                            <span>★</span>
                                        }
                                        else
                                        {
                                            <span>☆</span>
                                        }
                                    }
                                </span>
                                <span>@mockRating.ToString("F1")</span>
                                <span style="color: #565959;">(@mockReviewCount)</span>
                            </div>

                            <!-- Pricing details -->
                            <div class="promo-grid-price-row">
                                @if (hasDiscount)
                                {
                                    <span class="promo-grid-price-original">@originalPrice.ToString("N0") MMK</span>
                                    <span class="promo-grid-price-discounted">@discountedPrice.ToString("N0") MMK</span>
                                }
                                else
                                {
                                    <span class="promo-grid-price-discounted">@originalPrice.ToString("N0") MMK</span>
                                }
                            </div>

                            <!-- Badges -->
                            @if (selectedPromotionDetail != null)
                            {
                                @if (selectedPromotionDetail.DiscountPercent > 0)
                                {
                                    <span class="promo-grid-badge">Savings: @(selectedPromotionDetail.DiscountPercent.ToString("0.##"))% OFF applied</span>
                                }
                                else if (selectedPromotionDetail.PromoCode == "LOYAL2X")
                                {
                                    <span class="promo-grid-badge" style="background:#FFF3EE; color:#C9A96E; border:1px solid #EDD9D0;">Promo: Double Points Active</span>
                                }
                            }

                            <!-- Delivery -->
                            <p class="promo-grid-delivery">
                                FREE delivery <strong>tomorrow</strong> in Yangon.<br/>
                                Or fastest delivery <strong>today</strong>.
                            </p>


                        </div>
                    }
                </div>
            </div>
        }
    }

    
    else if (activeTab == "about")
    {
        <!-- Hero Banner -->
        <section style="
            position: relative;
            background: url('https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1400&q=80') center/cover no-repeat;
            min-height: 420px;
            display: flex;
            align-items: flex-end;
            overflow: hidden;">
            <div style="position:absolute; inset:0; background: linear-gradient(160deg, rgba(60,31,16,0.55) 0%, rgba(139,26,26,0.75) 100%);"></div>
            <div style="position:relative; z-index:1; padding: 60px 48px; max-width: 680px;">
                <span style="font-size:0.6rem; letter-spacing:0.35em; text-transform:uppercase; color:rgba(245,240,232,0.7); font-weight:600; display:block; margin-bottom:12px;">Est. 2018 · Yangon, Myanmar</span>
                <h1 style="font-family:'DM Sans',sans-serif; font-size:clamp(2rem,4vw,3.2rem); font-weight:300; color:#F5F0E8; line-height:1.15; margin:0 0 16px; letter-spacing:0.02em;">
                    Crafted with <em style="font-style:italic; color:#C9A96E;">intention</em>,<br/>worn with grace.
                </h1>
                <p style="font-size:0.95rem; color:rgba(245,240,232,0.8); line-height:1.85; max-width:520px; margin:0;">
                    Chic Boutique is an independent atelier rooted in Yangon's Golden Valley, dedicated to creating timeless garments for the modern woman.
                </p>
            </div>
        </section>

        <!-- Our Story -->
        <section style="max-width:1100px; margin:0 auto; padding:72px 40px 0;">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center;">
                <div>
                    <span style="font-size:0.6rem; letter-spacing:0.3em; text-transform:uppercase; color:var(--rose); font-weight:600;">Our Story</span>
                    <h2 style="font-family:'DM Sans',sans-serif; font-size:2rem; font-weight:400; color:var(--charcoal); margin:12px 0 24px; line-height:1.2;">
                        From a small studio to a <em style="color:var(--rose); font-style:italic;">curated atelier</em>
                    </h2>
                    <p style="font-size:0.9rem; color:var(--charcoal-soft); line-height:1.9; margin-bottom:16px;">
                        Founded in 2018 by a group of passionate fashion graduates, Chic Boutique began as a made-to-order studio tucked in a quiet corner of Bahan Township. Our founders believed that luxury should be accessible — not defined by price tags, but by the quality of craft and the intention behind every stitch.
                    </p>
