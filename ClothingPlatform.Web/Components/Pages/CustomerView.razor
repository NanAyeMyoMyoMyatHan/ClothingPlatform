                    <h2 style="font-family:'DM Sans',sans-serif; font-size:1.15rem; font-weight:500; color:var(--charcoal); margin:4px 0 0; letter-spacing:0.03em;">
                        Featured <span style="color:var(--rose);">Promotions</span>
                    </h2>
                </div>
                <span style="font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--charcoal-soft); opacity:0.7;">@promotionsList.Count offer@(promotionsList.Count != 1 ? "s" : "") live</span>
            </div>
            <div class="promo-carousel-wrapper">
                <div class="promo-slide"
                     style="background: url('@promotionsList[currentPromoSlideIndex].ImageUrl') center/cover no-repeat;"
                     @onclick="() => ClickPromoSlide(promotionsList[currentPromoSlideIndex])">

                    <!-- Warm gradient overlay -->
                    <div class="promo-overlay"></div>

                    <!-- Text anchored bottom-left -->
                    <div class="promo-content">
                        <span class="promo-subtitle">@promotionsList[currentPromoSlideIndex].Subtitle</span>
                        <h2 class="promo-title">@promotionsList[currentPromoSlideIndex].Title</h2>
                        <p class="promo-desc">@promotionsList[currentPromoSlideIndex].Description</p>
                    </div>

                    <!-- Slide dots — bottom right -->
                    <div class="promo-dots">
                        @for (int i = 0; i < promotionsList.Count; i++)
                        {
                            int index = i;
                            <span class="promo-dot @(currentPromoSlideIndex == index ? "active" : "")"
                                  @onclick="() => SetPromoSlide(index)" @onclick:stopPropagation="true"></span>
                        }
                    </div>
                </div>
            </div>
        }

        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; padding:0 2px;">
            <div>
                <span style="font-size:0.6rem; letter-spacing:0.25em; text-transform:uppercase; color:var(--charcoal-soft); font-weight:600;">This Week</span>
                <h2 style="font-family:'DM Sans',sans-serif; font-size:1.15rem; font-weight:500; color:var(--charcoal); margin:4px 0 0; letter-spacing:0.03em;">
                    New <span style="color:var(--rose); font-style:italic;">Creations</span>
                </h2>
            </div>
            <span style="font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--charcoal-soft); opacity:0.7;">Featured Releases</span>
        </div>

        <div class="products-grid">
            @foreach (var prod in newCreation)
            {
                var primaryImg = NormalizeImageUrl(prod.ImageDto);
                var mockRating = 4.5 + (prod.ProductId % 6) * 0.1;
                var mockReviewCount = 12 + (prod.ProductId * 7) % 85;

                <div class="promo-grid-card" style="cursor: pointer;" @onclick="() => OpenQuickViewss(prod)">
                    <div class="promo-grid-img-wrap">
                        <FallbackImage Src="@primaryImg" Alt="@prod.Name" />
                    </div>

                    <h3 class="promo-grid-title">@prod.Name</h3>
                    <p style="font-size: 0.7rem; color: var(--rose); font-weight: 600; text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.04em;">@prod.CategoryName</p>

                    <!-- Star Rating -->
                    <div class="promo-grid-rating">
                        <span class="promo-grid-stars">
                            @for (int s = 1; s <= 5; s++)
                            {
                                if (s <= Math.Round(mockRating))
                                {
                                    <span>★</span>
                                }
                                else
                                {
                                    <span>☆</span>
                                }
                            }
                        </span>
                        <span>@mockRating.ToString("F1")</span>
                        <span style="color: #565959;">(@mockReviewCount)</span>
                    </div>

                    <!-- Pricing details -->
                    <div class="promo-grid-price-row">
                        <span class="promo-grid-price-discounted">@prod.SalePrice.ToString("N0") MMK</span>
                    </div>

                    <!-- Badge -->
                    <span class="promo-grid-badge">New Arrival</span>

                    <!-- Delivery -->
                    <p class="promo-grid-delivery">
                        FREE delivery <strong>tomorrow</strong> in Yangon.<br/>
                        Or fastest delivery <strong>today</strong>.
                    </p>
                </div>
            }
        </div>
        <Pagination CurrentPage="@PageNoC"
                    TotalPages="@TotalPagesC"
                    CurrentPageChanged="@ChangePage" />
        
    }

    else if (activeTab == "best")
    {
