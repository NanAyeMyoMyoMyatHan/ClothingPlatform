                    <h2 style="font-family:'DM Sans',sans-serif; font-size:1.8rem; font-weight:400; color:var(--charcoal); margin:12px 0 0;">Our Core Values</h2>
                </div>
                <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:28px;">
                    @{
                        var values = new[]
                        {
                            ("bi-gem", "Timeless Quality", "Every piece is crafted from carefully sourced fabrics and finished by hand. We believe clothing should outlast seasons."),
                            ("bi-heart", "Women-Centered", "Designed by women, for women. Every silhouette, every cut is made with the real female form in mind."),
                            ("bi-leaf", "Sustainable Craft", "We source locally, minimise waste, and work with artisan weavers across Myanmar to sustain traditional textile arts."),
                            ("bi-palette", "Refined Aesthetics", "We pursue beauty that transcends trends — subtle, deliberate, and distinctly Chic Boutique."),
                            ("bi-people", "Community First", "From our team to our clients, relationships are at the heart of everything we do at the atelier."),
                            ("bi-star", "Exceptional Service", "From first stitch to final delivery, we treat every client as a VIP guest of the atelier."),
                        };
                    }
                    @foreach (var (icon, name, description) in values)
                    {
                        <div style="background:var(--white); border:1px solid var(--rose-light); border-radius:14px; padding:28px 24px; transition:box-shadow 0.2s;">
                            <div style="width:46px; height:46px; border-radius:12px; background:linear-gradient(135deg,#FFF3EE,#FDF8F6); border:1px solid var(--rose-light); display:flex; align-items:center; justify-content:center; margin-bottom:16px;">
                                <i class="bi @icon" style="font-size:1.2rem; color:var(--rose);"></i>
                            </div>
                            <h4 style="font-size:0.92rem; font-weight:600; color:var(--charcoal); margin:0 0 10px;">@name</h4>
                            <p style="font-size:0.82rem; color:var(--charcoal-soft); line-height:1.75; margin:0;">@description</p>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- Team / Atelier -->
        <section style="max-width:1100px; margin:0 auto; padding:72px 40px;">
            <div style="text-align:center; margin-bottom:48px;">
